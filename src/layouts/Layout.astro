        ))}

        <!-- ── Thick divider ── -->
        <div class="drawer-band"></div>

        <!-- ── Information / Pages ── -->
        <p class="drawer-section-label">Information</p>

        <a href="/" class="drawer-page-link">Home</a>
        <a href="/pages/about-us" class="drawer-page-link">About Us</a>
        <a href="/pages/working-hours" class="drawer-page-link">Working Hours</a>
        <a href="/pages/shipping-delivery" class="drawer-page-link">Shipping &amp; Delivery</a>
        <a href="/pages/refund-cancellation-policy" class="drawer-page-link">Refund &amp; Cancellation Policy</a>
        <a href="/pages/cookies-policy" class="drawer-page-link">Cookies Policy</a>
        <a href="/pages/terms-and-conditions" class="drawer-page-link">Terms &amp; Conditions</a>
        <a href="/pages/terms-of-service" class="drawer-page-link">Terms of Service</a>
        <a href="/pages/legal-notice" class="drawer-page-link">Legal Notice</a>

      </nav>

      <!-- Footer: account + lang -->
      <div class="drawer-footer">
        <a href="/account" class="drawer-footer-link">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          My Account
        </a>
        <div class="drawer-lang">
          <span class="lang-active">EN</span>
          <span class="lang-sep">/</span>
          <span class="lang-inactive">GR</span>
        </div>
      </div>

    </div>

    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-inner">
          <!-- Column 1: Contact -->
          <div class="footer-col">
            <h3 class="footer-heading">Contact</h3>
            <ul class="footer-list">
              <li>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                Limassol, Cyprus
