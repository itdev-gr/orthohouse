      <!-- Scrollable nav body -->
      <nav class="drawer-nav">

        <!-- ── Shop / Categories ── -->
        <p class="drawer-section-label">Shop</p>

        {NAV_CATEGORIES.map((cat, i) => (
          <div class="drawer-cat-item">
            {cat.children.length > 0 ? (
              <button type="button" class="drawer-trigger" data-drawer-index={i}>
                <span>{cat.label}</span>
                <svg class="drawer-chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="15" height="15">
