              <!-- Col 2 · Popular Products -->
              <div class="sov-col">
                <h3 class="sov-col-title">Popular Products</h3>
                {popularProducts.map((p: any) => {
                  const d = pdp(p);
                  return (
                    <a href={`/products/${p.handle}`} class="sov-prod" id="sov-link">
                      <div class="sov-prod-thumb">
                        {p.featuredImage
                          ? <img src={shopifyThumb(p.featuredImage.url, 120)} alt={p.featuredImage.altText || p.title} width="80" height="80" loading="lazy" />
                          : <div class="sov-prod-no-img" />}
                      </div>
                      <div class="sov-prod-info">
                        <p class="sov-prod-name">{p.title}</p>
                        <div class="sov-price-row">
                          {d.isSale && <s class="sov-compare-price">{d.currency} {d.compareAt.toFixed(2)}</s>}
                          <span class={`sov-curr-price${d.isSale ? " sale" : ""}`}>{d.currency} {d.price.toFixed(2)}</span>
                        </div>
                        <span class={`sov-avail${d.isAvail ? " in" : " out"}`}>● {d.isAvail ? "In Stock" : "Out of Stock"}</span>
