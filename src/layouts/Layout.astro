---
import { shopifyConfig, getOverlayProducts, getCollectionPreview } from "../lib/shopify";
import { NAV_CATEGORIES } from "../lib/menuConfig";

interface Props {
  title: string;
  swrData?: {
    query: string;
    variables: Record<string, unknown>;
    data: unknown;
    extract: string;
  };
}
const { title, swrData } = Astro.props;

// ── Search overlay data ────────────────────────────────────────────────────
const overlayAllProducts = await getOverlayProducts(20);
const wheelchairPreview  = await getCollectionPreview("wheelchairs-and-home-care-aids", 3);

// Section splits
const newProducts     = overlayAllProducts.slice(0, 3);
const popularProducts = overlayAllProducts.slice(3, 6);

const saleProducts = overlayAllProducts
  .filter((p: any) => {
    const v = p.variants?.nodes?.[0];
    if (!v?.compareAtPrice) return false;
    const price   = parseFloat(v.price?.amount ?? "0");
    const compare = parseFloat(v.compareAtPrice?.amount ?? "0");
    return compare > 0 && compare > price;
  })
  .slice(0, 3);

// Fallback when nothing is on sale
const saleProductsFinal = saleProducts.length > 0 ? saleProducts : overlayAllProducts.slice(6, 9);
const saleColTitle      = saleProducts.length > 0 ? "On Sale"    : "Featured";

const wheelchairProducts =
  wheelchairPreview.length > 0 ? wheelchairPreview : overlayAllProducts.slice(9, 12);

// Helper: extract price / sale / availability data from a raw Shopify product node
function pdp(p: any) {
  const v        = p.variants?.nodes?.[0];
  const price    = parseFloat(v?.price?.amount ?? p.priceRange?.minVariantPrice?.amount ?? "0");
  const compareAt= parseFloat(v?.compareAtPrice?.amount ?? "0");
  const currency = v?.price?.currencyCode ?? p.priceRange?.minVariantPrice?.currencyCode ?? "EUR";
  const isAvail  = v?.availableForSale ?? true;
  const isSale   = compareAt > 0 && compareAt > price;
  return { price, compareAt, currency, isAvail, isSale };
}

// Compact JSON embedded for client-side live search
const sovSearchData = JSON.stringify(
  overlayAllProducts.map((p: any) => {
    const d = pdp(p);
    return {
      t:  p.title,
      h:  p.handle,
      p:  d.price,
      c:  d.isSale ? d.compareAt : 0,
      cu: d.currency,
      a:  d.isAvail,
      i:  p.featuredImage?.url ?? "",
    };
  })
);

function shopifyThumb(url: string, w = 300) {
  if (!url) return url;
  const sep = url.includes('?') ? '&' : '?';
  return `${url}${sep}width=${w}`;
}
---

<!doctype html>
