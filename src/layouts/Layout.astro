    <!-- ══════════════════════════════════════
         SEARCH OVERLAY — open / close / search
         ══════════════════════════════════════ -->
    <script is:inline>
    (function () {
      var backdrop      = document.getElementById("sov-backdrop");
      var panel         = document.getElementById("sov-panel");
      var sovInput      = document.getElementById("sov-input");
      var sovClose      = document.getElementById("sov-close");
      var sovFeatured   = document.getElementById("sov-featured");
      var sovHint       = document.getElementById("sov-hint");
      var sovResults    = document.getElementById("sov-results");
      var sovResGrid    = document.getElementById("sov-results-grid");
      var sovSeeAll     = document.getElementById("sov-see-all");
      var sovQueryLabel = document.getElementById("sov-query-label");

      /* ── Load embedded product data ── */
      var searchData = [];
      try {
        searchData = JSON.parse(
          document.getElementById("sov-search-data").textContent || "[]"
        );
      } catch (e) {}

      /* ── Open / close helpers ── */
      function openSOV() {
        if (!backdrop) return;
        backdrop.classList.add("is-open");
        document.body.style.overflow = "hidden";
        // Focus the overlay input after the slide-up animation starts
        setTimeout(function () { if (sovInput) sovInput.focus(); }, 320);
      }
      window.openSOV = openSOV; // expose for the inline header handler

      function closeSOV() {
        if (!backdrop) return;
        backdrop.classList.remove("is-open");
        document.body.style.overflow = "";
        if (sovInput) sovInput.value = "";
        if (panel) panel.scrollTop = 0;
        showFeatured();
      }

      function showFeatured() {
        if (sovFeatured) sovFeatured.style.display = "";
        if (sovHint)     sovHint.style.display     = "";
        if (sovResults)  sovResults.style.display  = "none";
      }

      function showResults(query) {
        if (sovFeatured) sovFeatured.style.display = "none";
        if (sovHint)     sovHint.style.display     = "none";
        if (sovResults)  sovResults.style.display  = "";

        var q        = query.toLowerCase();
        var filtered = searchData.filter(function (p) {
          return p.t.toLowerCase().indexOf(q) !== -1;
        });

        if (filtered.length === 0) {
          if (sovResGrid) sovResGrid.innerHTML =
            '<p class="sov-no-results">No products found for &ldquo;' + query + '&rdquo;</p>';
          if (sovSeeAll) sovSeeAll.style.display = "none";
          return;
        }

        if (sovResGrid) {
          sovResGrid.innerHTML = filtered.slice(0, 12).map(function (p) {
            var isSale    = p.c > 0 && p.c > p.p;
            var priceHtml = isSale
              ? '<s class="sov-compare-price">' + p.cu + " " + p.c.toFixed(2) + '</s>'
                + '<span class="sov-curr-price sale">' + p.cu + " " + p.p.toFixed(2) + "</span>"
              : '<span class="sov-curr-price">'  + p.cu + " " + p.p.toFixed(2) + "</span>";
            var availHtml = '<span class="sov-avail ' + (p.a ? "in" : "out") + '">'
              + "● " + (p.a ? "In Stock" : "Out of Stock") + "</span>";
            var imgHtml = p.i
              ? '<img src="' + p.i + (p.i.indexOf('?')>-1?'&':'?') + 'width=120" alt="' + p.t.replace(/"/g, "&quot;") + '" width="80" height="80" loading="lazy" />'
              : '<div class="sov-prod-no-img"></div>';
            return (
              '<a href="/products/' + p.h + '" class="sov-prod sov-result-item">'
              + '<div class="sov-prod-thumb">' + imgHtml + "</div>"
              + '<div class="sov-prod-info">'
              +   '<p class="sov-prod-name">' + p.t + "</p>"
              +   '<div class="sov-price-row">' + priceHtml + "</div>"
              +   availHtml
              + "</div></a>"
            );
          }).join("");
        }

        if (sovSeeAll && sovQueryLabel) {
          sovQueryLabel.textContent = query;
          sovSeeAll.href = "/search?q=" + encodeURIComponent(query);
          sovSeeAll.style.display = "";
        }
      }

      /* ── Input events ── */
      if (sovInput) {
        sovInput.addEventListener("input", function () {
          var q = sovInput.value.trim();
          if (q.length === 0) showFeatured();
          else                showResults(q);
        });
        sovInput.addEventListener("keydown", function (e) {
          if (e.key === "Enter") {
            var q = sovInput.value.trim();
            if (q) window.location.href = "/search?q=" + encodeURIComponent(q);
          }
        });
      }

      /* ── Quick pills ── */
      document.querySelectorAll(".sov-pill").forEach(function (pill) {
        pill.addEventListener("click", function () {
          var q = pill.getAttribute("data-q");
          if (sovInput) sovInput.value = q;
          showResults(q);
          if (sovInput) sovInput.focus();
        });
      });

      /* ── Close on backdrop click ── */
      if (backdrop) {
        backdrop.addEventListener("click", function (e) {
          if (e.target === backdrop) closeSOV();
        });
      }
      if (sovClose) sovClose.addEventListener("click", closeSOV);

      /* ── Close product links (close overlay when navigating) ── */
      if (backdrop) {
        backdrop.addEventListener("click", function (e) {
          var link = e.target.closest(".sov-prod");
          if (link) {
            backdrop.classList.remove("is-open");
            document.body.style.overflow = "";
          }
        });
      }

      /* ── Escape key ── */
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && backdrop && backdrop.classList.contains("is-open")) {
          closeSOV();
        }
      });
    })();
    </script>

    <!-- Mega-menu + mobile drawer interaction -->
    <script is:inline>
    (function () {
      /* ── Desktop mega-menu ── */
      var catItems = document.querySelectorAll(".cat-item");
      var triggers = document.querySelectorAll(".cat-trigger[aria-expanded]");
      var panels = document.querySelectorAll(".mega-panel");

      function closeAllPanels() {
        triggers.forEach(function (t) {
          t.setAttribute("aria-expanded", "false");
          t.classList.remove("is-active");
        });
        catItems.forEach(function (item) {
          item.classList.remove("is-open");
        });
        panels.forEach(function (p) {
          p.classList.remove("is-open");
        });
      }

      triggers.forEach(function (trigger) {
        trigger.addEventListener("click", function (e) {
          e.stopPropagation();
          var item = trigger.closest(".cat-item");
          var idx = item.getAttribute("data-index");
          var panel = document.getElementById("mega-panel-" + idx);
          var isOpen = item.classList.contains("is-open");

          closeAllPanels();

          if (!isOpen) {
            item.classList.add("is-open");
            trigger.setAttribute("aria-expanded", "true");
            trigger.classList.add("is-active");
            if (panel) panel.classList.add("is-open");
          }
        });
      });

      document.addEventListener("click", function (e) {
        if (!e.target.closest(".cat-bar")) {
          closeAllPanels();
        }
        if (!e.target.closest(".pages-menu")) {
          closePagesMenu();
        }
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
          closeAllPanels();
          closePagesMenu();
          closeDrawer();
        }
      });

      /* ── Pages menu dropdown ── */
      var pagesMenuBtn = document.getElementById("pages-menu-btn");
      var pagesMenuDropdown = document.getElementById("pages-menu-dropdown");

      function closePagesMenu() {
        if (pagesMenuBtn) pagesMenuBtn.setAttribute("aria-expanded", "false");
        if (pagesMenuDropdown) pagesMenuDropdown.classList.remove("is-open");
      }

      if (pagesMenuBtn) {
        pagesMenuBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          closeAllPanels();
          openDrawer();
        });
      }

      /* ── Mobile drawer ── */
      var hamburgerBtn = document.getElementById("hamburger-btn");
      var drawer = document.getElementById("mobile-drawer");
      var overlay = document.getElementById("mobile-overlay");
      var closeBtn = document.getElementById("drawer-close");

      function openDrawer() {
        drawer.classList.add("is-open");
        overlay.classList.add("is-open");
        document.body.style.overflow = "hidden";
      }

      function closeDrawer() {
        drawer.classList.remove("is-open");
        overlay.classList.remove("is-open");
        document.body.style.overflow = "";
      }

      if (hamburgerBtn) hamburgerBtn.addEventListener("click", openDrawer);
      if (closeBtn) closeBtn.addEventListener("click", closeDrawer);
      if (overlay) overlay.addEventListener("click", closeDrawer);

      /* ── Mobile drawer accordion ── */
      var drawerTriggers = document.querySelectorAll(".drawer-trigger[data-drawer-index]");
      drawerTriggers.forEach(function (btn) {
        btn.addEventListener("click", function () {
          var idx = btn.getAttribute("data-drawer-index");
          var children = document.getElementById("drawer-children-" + idx);
          var isOpen = btn.classList.contains("is-expanded");
          drawerTriggers.forEach(function (b) {
            b.classList.remove("is-expanded");
            var c = document.getElementById("drawer-children-" + b.getAttribute("data-drawer-index"));
            if (c) c.style.maxHeight = null;
          });
          if (!isOpen && children) {
            btn.classList.add("is-expanded");
            children.style.maxHeight = children.scrollHeight + "px";
          }
        });
      });

      /* ── Search bar → opens overlay ── */
      (function () {
        var input = document.querySelector(".top-search-input");
        var icon  = document.querySelector(".top-search-icon");
        // Intercept mousedown so the input never actually gets focus
        if (input) {
          input.addEventListener("mousedown", function (e) {
            e.preventDefault();
            openSOV();
          });
        }
        if (icon) {
          icon.style.pointerEvents = "auto";
          icon.style.cursor = "pointer";
          icon.addEventListener("click", openSOV);
        }
        // Mobile search button
        var mobileSearchBtn = document.getElementById("mobile-search-btn");
        if (mobileSearchBtn) mobileSearchBtn.addEventListener("click", openSOV);
      })();
    })();
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    color: #1a1a1a;
    background: #fafafa;
    overflow-x: hidden;
  }

  /* ══════════════════════════════════════
     HEADER
     ══════════════════════════════════════ */
  header {
    position: relative;
    z-index: 100;
  }

  /* ── Row 1: White top bar ── */
  .top-bar {
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
    padding: 0 2rem;
  }
  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    height: 83px;
  }
  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-logo-img {
    height: 76px;
    width: auto;
    display: block;
  }

  /* ── Pages menu (hamburger + "Menu" right of logo) ── */
  .pages-menu {
    position: relative;
  }
  .pages-menu-btn {
    display: flex;
    align-items: center;
    gap: 0.62rem;
    padding: 0.62rem 1.24rem;
    font-size: 1.24rem;
    font-weight: 600;
    color: #1e3a5f;
    background: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .pages-menu-btn:hover {
    background: #f0f4ff;
  }
  .pages-menu-btn[aria-expanded="true"] {
    background: #f0f4ff;
  }
  .pages-menu-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 240px;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    z-index: 150;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.18s, visibility 0.18s, transform 0.18s;
    padding: 0.5rem 0;
    max-height: 80vh;
    overflow-y: auto;
  }
  .pages-menu-dropdown.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  /* Section header labels (e.g. "Categories", "Pages") */
  .pages-menu-section {
    display: block;
    padding: 0.55rem 1.25rem 0.2rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #999;
  }
  /* Divider between sections */
  .pages-menu-divider {
    border: none;
    border-top: 1px solid #f0f0f0;
    margin: 0.4rem 0;
  }
  .pages-menu-link {
    display: block;
    padding: 0.62rem 1.25rem;
    font-size: 0.92rem;
    color: #333;
    text-decoration: none;
    transition: background 0.12s, color 0.12s;
  }
  .pages-menu-link:hover {
    background: #f0f4ff;
    color: #1e3a5f;
  }

  /* ── Search bar (center) ── */
  .top-search {
    flex: 1;
    max-width: 480px;
    position: relative;
    margin: 0 1.5rem;
  }
  .top-search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #999;
    pointer-events: none;
  }
  .top-search-input {
    width: 100%;
    height: 55px;
    padding: 0 1.38rem 0 3.45rem;
    font-size: 1.21rem;
    font-family: inherit;
    color: #333;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    outline: none;
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
  }
  .top-search-input::placeholder {
    color: #aaa;
  }
  .top-search-input:focus {
    background: #fff;
    border-color: #1e3a5f;
    box-shadow: 0 0 0 2px rgba(30, 58, 95, 0.1);
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .top-icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 49px;
    height: 49px;
    border-radius: 8px;
    background: none;
    border: none;
    color: #444;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .top-icon-btn:hover {
    background: #f0f4ff;
    color: #1e3a5f;
  }
  .top-lang-btn {
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #444;
    padding: 0.41rem 0.83rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    font-family: inherit;
    white-space: nowrap;
  }
  .top-lang-btn:hover {
    border-color: #1e3a5f;
    color: #1e3a5f;
  }
  .lang-active { font-weight: 700; }
  .lang-sep { color: #bbb; margin: 0 1px; }
  .lang-inactive { color: #aaa; font-weight: 500; }

  /* Cart badge */
  .cart-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #1e3a5f;
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    min-width: 17px;
    height: 17px;
    line-height: 17px;
    text-align: center;
    border-radius: 9px;
    padding: 0 4px;
  }

  /* Hamburger — hidden on desktop */
  .hamburger-btn { display: none; }

  /* ── Row 2: Dark blue category bar ── */
  .cat-bar {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 100%);
    padding: 0 2rem;
    position: relative;
  }
  .cat-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    max-width: 1400px;
    margin: 0 auto;
    height: 79px;
    flex-wrap: wrap;
  }
  .cat-item {
    position: static;
    border-right: 2px solid rgba(255, 255, 255, 0.3);
    padding-right: 1rem;
  }
  .cat-item:last-child {
    border-right: none;
    padding-right: 0;
  }
  .cat-trigger {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.83rem 2rem;
    font-size: 1.15rem;
    font-weight: 500;
    color: #fff;
    background: transparent;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
    transition: background 0.15s;
    font-family: inherit;
    letter-spacing: 0.02em;
  }
  .cat-trigger:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .cat-trigger.is-active {
    background: rgba(255, 255, 255, 0.18);
  }
  .cat-chevron {
    transition: transform 0.2s;
    flex-shrink: 0;
    opacity: 0.7;
  }
  .cat-trigger.is-active .cat-chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* ── Mega Panel (dark blue dropdown) ── */
  .mega-panel {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #1e3a5f;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
    z-index: 101;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 0.18s, visibility 0.18s, transform 0.18s;
  }
  .mega-panel.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  .mega-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.75rem 2.5rem;
  }
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 0.35rem 1.5rem;
    margin-bottom: 1.25rem;
  }
  .mega-link {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    padding: 0.45rem 0.7rem;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s;
  }
  .mega-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }
  .mega-view-all {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    transition: color 0.15s;
  }
  .mega-view-all:hover {
    color: #fff;
    text-decoration: underline;
  }

  /* ══════════════════════════════════════
     SIDE OVERLAY & DRAWER
     ══════════════════════════════════════ */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 199;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.32s ease, visibility 0.32s ease;
  }
  .mobile-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Drawer panel */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 340px;
    max-width: 88vw;
    height: 100vh;
    height: 100dvh;
    background: #fff;
    z-index: 200;
    transform: translateX(-100%);
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 6px 0 40px rgba(0, 0, 0, 0.18);
    overflow: hidden;
  }
  .mobile-drawer.is-open {
    transform: translateX(0);
  }


  /* ── Scrollable nav body ── */
  .drawer-nav {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .drawer-nav::-webkit-scrollbar { width: 4px; }
  .drawer-nav::-webkit-scrollbar-thumb { background: #e0e0e0; border-radius: 2px; }

  /* Section labels */
  .drawer-section-label {
    padding: 1.1rem 1.25rem 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #b0b8c8;
    margin: 0;
  }

  /* Category rows */
  .drawer-cat-item {
    border-bottom: 1px solid #f0f2f5;
  }
  .drawer-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.95rem 1.25rem;
    font-size: 0.97rem;
    font-weight: 600;
    color: #1a1a2e;
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
    text-align: left;
    transition: background 0.15s, color 0.15s;
    line-height: 1.3;
  }
  .drawer-trigger:hover {
    background: #f4f7ff;
    color: #1e3a5f;
  }
  .drawer-trigger.is-expanded {
    color: #1e3a5f;
    background: #eef2fc;
  }
  .drawer-chevron {
    flex-shrink: 0;
    color: #c8cdd8;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), color 0.15s;
  }
  .drawer-trigger.is-expanded .drawer-chevron {
    transform: rotate(90deg);
    color: #1e3a5f;
  }

  /* Sub-links (children) */
  .drawer-children {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.38s cubic-bezier(0.4, 0, 0.2, 1);
    background: #f8faff;
    border-top: 1px solid #eef0f7;
  }
  .drawer-sub-link {
    display: block;
    padding: 0.65rem 1.25rem 0.65rem 2rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: #4a5568;
    text-decoration: none;
    border-bottom: 1px solid #f0f2f7;
    transition: color 0.15s, background 0.15s;
  }
  .drawer-sub-link:last-child {
    border-bottom: none;
  }
  .drawer-sub-link:hover {
    color: #1e3a5f;
    background: #edf2ff;
  }
  .drawer-view-all {
    font-weight: 700;
    color: #1e3a5f;
    font-size: 0.82rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-top: 1px solid #dde5ff;
  }
  .drawer-view-all:hover {
    background: #e8edff;
  }

  /* Thick divider band */
  .drawer-band {
    height: 7px;
    background: #f0f2f7;
    margin: 0.35rem 0;
  }

  /* Page links */
  .drawer-page-link {
    display: block;
    padding: 0.82rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #444;
    text-decoration: none;
    border-bottom: 1px solid #f4f4f6;
    transition: color 0.15s, background 0.15s;
  }
  .drawer-page-link:hover {
    color: #1e3a5f;
    background: #f4f7ff;
  }

  /* ── Drawer footer ── */
  .drawer-footer {
    padding: 1rem 1.25rem;
    border-top: 2px solid #eef0f7;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    background: #fff;
  }
  .drawer-footer-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e3a5f;
    text-decoration: none;
    transition: color 0.15s;
  }
  .drawer-footer-link:hover {
    color: #2d5a8e;
  }
  .drawer-lang {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #666;
  }

  /* ══════════════════════════════════════
     MOBILE BREAKPOINT
     ══════════════════════════════════════ */
  @media (max-width: 768px) {
    .top-bar { padding: 0 1rem; }
    .top-bar-inner { height: 72px; }
    .cat-bar { display: none; }
    .top-lang-btn { display: none; }
    .top-profile { display: none; }
    .hamburger-btn { display: flex; }
    .mobile-search-btn { display: flex; }
    .nav-logo-img { height: 52px; }
    .pages-menu { display: none; }
    .top-search { display: none; }

    /* Overlay mobile tweaks */
    .sov-inner { padding: 1.25rem 1rem 2rem; }
    .sov-panel { max-height: 92vh; border-radius: 16px 16px 0 0; }
    .sov-cols,
    .sov-results-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem 1rem; }
    .sov-col-title { font-size: 0.68rem; }
    .sov-prod-thumb { width: 50px; height: 50px; }
    .sov-prod-name { font-size: 0.75rem; }
  }

  /* ══════════════════════════════════════
     MAIN CONTENT & FOOTER
     ══════════════════════════════════════ */
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }
  /* ══════════════════════════════════════
     FOOTER
     ══════════════════════════════════════ */
  .site-footer {
    margin-top: 3rem;
  }

  /* Main footer area */
  .footer-main {
    background: #1e3a5f;
    padding: 3rem 2rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer-col {}
  .footer-heading {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1.25rem;
    letter-spacing: 0.02em;
  }
  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  .footer-list li svg {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.5);
  }
  .footer-list li a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-list li a:hover {
    color: #fff;
    text-decoration: underline;
  }

  /* Payment methods strip */
  .footer-payments {
    background: #17304f;
    padding: 1.25rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer-payments-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-payments-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .footer-newsletter-text {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin: 0 0 0.75rem 0;
  }
  .footer-newsletter {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 0.5rem 0.85rem;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .footer-newsletter-icon {
    color: rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
  }
  .footer-newsletter-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-size: 0.875rem;
    color: #fff;
    font-family: inherit;
  }
  .footer-newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .payment-icons {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
    margin-bottom: 3rem;
  }
  .payment-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  /* Copyright bar */
  .footer-bottom {
    background: #122a42;
    padding: 1rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-bottom-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .footer-bottom p {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
  }
  .footer-bottom-links {
    display: flex;
    gap: 1.5rem;
  }
  .footer-bottom-links a {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-bottom-links a:hover {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: underline;
  }

  .footer-powered {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
  }
  .footer-powered a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-powered a:hover {
    color: #fff;
    text-decoration: underline;
  }

  /* Mobile search button — hidden on desktop, shown on mobile via media query above */
  @media (min-width: 769px) {
    .mobile-search-btn { display: none; }
  }

  /* ══════════════════════════════════════
     SEARCH OVERLAY
     ══════════════════════════════════════ */

  /* Backdrop (darkened page) */
  .sov-backdrop {
    position: fixed;
    inset: 0;
    z-index: 250;
    background: rgba(10, 18, 35, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .sov-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Slide-up panel */
  .sov-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 20px 20px 0 0;
    max-height: 88vh;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.42s cubic-bezier(0.32, 0.72, 0, 1);
    box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.18);
  }
  .sov-backdrop.is-open .sov-panel {
    transform: translateY(0);
  }

  /* Inner content — max-width constrained */
  .sov-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 2rem 2.5rem;
  }

  /* ── Search header row ── */
  .sov-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid #eef0f3;
    padding-bottom: 1rem;
  }
  .sov-input-wrap {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
  }
  .sov-icon {
    position: absolute;
    left: 0.85rem;
    color: #9ca3af;
    pointer-events: none;
    flex-shrink: 0;
  }
  .sov-input {
    width: 100%;
    height: 48px;
    padding: 0 1rem 0 2.75rem;
    font-size: 1rem;
    font-family: inherit;
    color: #1a1a1a;
    background: #f5f7fa;
    border: 1.5px solid #e5e7eb;
    border-radius: 10px;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .sov-input::placeholder { color: #aab0bb; }
  .sov-input:focus {
    border-color: #1e3a5f;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(30, 58, 95, 0.08);
  }
  .sov-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 10px;
    border: 1.5px solid #e5e7eb;
    background: #fff;
    color: #555;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .sov-close:hover {
    background: #f5f7fa;
    border-color: #1e3a5f;
    color: #1e3a5f;
  }

  /* ── Quick pills ── */
  .sov-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .sov-pill {
    padding: 0.35rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: inherit;
    color: #1e3a5f;
    background: #eef2f8;
    border: 1.5px solid #d5dff0;
    border-radius: 20px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
    white-space: nowrap;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .sov-pill:hover {
    background: #1e3a5f;
    border-color: #1e3a5f;
    color: #fff;
  }

  /* ── Hint text ── */
  .sov-hint {
    font-size: 0.85rem;
    color: #9ca3af;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  /* ── 4-column featured grid ── */
  .sov-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .sov-col-title {
    font-size: 0.72rem;
    font-weight: 700;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #f0f2f5;
  }

  /* ── Product row ── */
  .sov-prod {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid #f5f6f8;
    transition: background 0.12s;
    border-radius: 6px;
  }
  .sov-prod:last-child { border-bottom: none; }
  .sov-prod:hover { background: #f8fafc; }

  /* Thumbnail */
  .sov-prod-thumb {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #f0f4f8;
    border: 1px solid #e8edf3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sov-prod-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
    display: block;
  }
  .sov-prod-no-img {
    width: 100%;
    height: 100%;
    background: #e8edf3;
    border-radius: 8px;
  }

  /* Info area */
  .sov-prod-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }
  .sov-prod-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sov-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .sov-curr-price {
    font-size: 0.82rem;
    font-weight: 700;
    color: #1e3a5f;
  }
  .sov-curr-price.sale { color: #dc2626; }
  .sov-compare-price {
    font-size: 0.75rem;
    color: #9ca3af;
    text-decoration: line-through;
  }
  .sov-avail {
    font-size: 0.7rem;
    font-weight: 600;
  }
  .sov-avail.in  { color: #16a34a; }
  .sov-avail.out { color: #dc2626; }

  /* ── Live search results grid ── */
  .sov-results-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0 1.5rem;
  }
  .sov-no-results {
    font-size: 0.9rem;
    color: #9ca3af;
    padding: 1rem 0;
    grid-column: 1 / -1;
  }

  /* "See all results" link */
  .sov-see-all {
    display: block;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e3a5f;
    text-decoration: none;
    padding: 0.6rem 0;
    border-top: 1px solid #f0f2f5;
    transition: color 0.15s;
  }
  .sov-see-all:hover { color: #2563eb; text-decoration: underline; }

  /* ── Tablet: 2 cols ── */
  @media (max-width: 1024px) {
    .sov-cols,
    .sov-results-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Footer mobile */
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
