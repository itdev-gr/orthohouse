                </svg>
              </button>
            ) : (
              <a href={`/collections/${cat.handle}`} class="drawer-trigger">
                <span>{cat.label}</span>
              </a>
            )}
            {cat.children.length > 0 && (
              <div class="drawer-children" id={`drawer-children-${i}`}>
                {cat.children.map((sub) => (
                  <a href={`/collections/${sub.handle}`} class="drawer-sub-link">
                    {sub.label}
                  </a>
                ))}
                <a href={`/collections/${cat.handle}`} class="drawer-sub-link drawer-view-all">
                  View all {cat.label} &rarr;
                </a>
              </div>
            )}
