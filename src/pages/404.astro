---
import { shopifyConfig } from "../lib/shopify";
const primary = shopifyConfig.primaryDomain;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      body { font-family: system-ui, -apple-system, sans-serif; max-width: 540px; margin: 4rem auto; padding: 0 1rem; color: #1e3a5f; }
      h1 { font-size: 2rem; margin: 0 0 0.5rem; }
      p { color: #555; line-height: 1.6; }
      a { color: #2563eb; }
    </style>
  </head>
  <body>
    <script is:inline set:html={`
      (function () {
        var path = window.location.pathname;
        var rest = window.location.search + window.location.hash;
        var m = path.match(/^(\\/el)?\\/account\\/(activate|reset)\\/.+/);
        if (m) {
          window.location.replace(${JSON.stringify("https://" + primary)} + path + rest);
        }
      })();
    `}></script>
    <h1>Page not found</h1>
    <p>The page you were looking for doesn't exist.</p>
    <p><a href="/">← Back to home</a></p>
  </body>
</html>
