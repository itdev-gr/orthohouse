---
import Layout from "../../layouts/Layout.astro";
import {
  getCollections,
  getCollectionWithProducts,
  COLLECTION_PRODUCTS_QUERY,
} from "../../lib/shopify";
import {
  NAV_CATEGORIES,
  findNavCategory,
  getCategoryLabel,
  getCategorySlogan,
  getSubLabel,
  getSubDescription,
} from "../../lib/menuConfig";
import { QUOTATION_COLLECTION_HANDLES } from "../../lib/quotationCollections";
import RecentlyViewed from "../../components/RecentlyViewed.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { pickLang, useTranslations, localizeHref } from "../../i18n/utils";

export async function getStaticPaths() {
  const collections = await getCollections();
  const shopifyHandles = new Set(collections.map((c: any) => c.handle));
  const navHandles = NAV_CATEGORIES.flatMap((c) => [
    c.handle,
    ...c.children.map((s) => s.handle),
  ]);
  const allHandles = new Set<string>([...shopifyHandles, ...navHandles]);
  return Array.from(allHandles).map((handle) => ({ params: { handle } }));
}

const lang = pickLang(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizeHref(p, lang);

const { handle } = Astro.params;
const navCategory = findNavCategory(handle!);
const navSubMatch = NAV_CATEGORIES.flatMap((c) => c.children).find(
  (s) => s.handle === handle,
);
const { collection, products } = await getCollectionWithProducts(handle!);

// 404 only when Shopify and nav config both don't know this handle.
if (!collection && !navCategory && !navSubMatch) return Astro.redirect("/404");

const isTopLevel = !!navCategory;
const navTitle = navCategory ? getCategoryLabel(navCategory, lang) : navSubMatch ? getSubLabel(navSubMatch, lang) : undefined;
const pageTitle = collection?.title ?? navTitle ?? handle!;

const WIDGET_PATTERNS = [
  /TRANSLATE\s+with/i,
  /LanguageMenu/,
  /langMenu\./,
  /EMBED THE SNIPPET/i,
  /Enable collaborative/i,
];
const rawDesc = collection?.description ?? "";
const isGarbageDesc = WIDGET_PATTERNS.some((re) => re.test(rawDesc));
const safeDescription = isGarbageDesc ? "" : rawDesc;

const accent = navCategory?.banner?.accent ?? "#1e3a5f";
const titlePosition = navCategory?.banner?.titlePosition ?? "bottom-left";
const bannerImage = navCategory?.banner?.image;
const supplierLogos = navCategory?.supplierLogos ?? [];
const subcategories = navCategory?.children ?? [];
const isQuoteCollection = QUOTATION_COLLECTION_HANDLES.has(handle!);

// Breadcrumb crumbs: Home > Products > [Parent if subcat] > Current
function buildCollectionCrumbs() {
  const crumbs: { label: string; href: string | null }[] = [
    { label: t("nav.home"), href: lp("/") },
    { label: lang === "el" ? "Προϊόντα" : "Products", href: lp("/#cat-section") },
  ];
  if (isTopLevel) {
    crumbs.push({ label: pageTitle, href: null });
  } else {
    const parent = NAV_CATEGORIES.find((c) => c.children.some((ch) => ch.handle === handle));
    if (parent) {
      crumbs.push({
        label: getCategoryLabel(parent, lang),
        href: lp(`/collections/${parent.handle}`),
      });
    }
    crumbs.push({ label: pageTitle, href: null });
  }
  return crumbs;
}
const collectionCrumbs = buildCollectionCrumbs();
---

<Layout
  title={pageTitle}
  swrData={collection ? {
    query: COLLECTION_PRODUCTS_QUERY,
    variables: { handle, first: 50 },
    data: products,
    extract: "collection.products.nodes",
  } : undefined}
>
  <Breadcrumb crumbs={collectionCrumbs} />
  {isTopLevel ? (
    <>
      <section
        class:list={["cat-banner", `pos-${titlePosition}`]}
        style={`--accent: ${accent}; ${bannerImage ? `--banner-image: url('${bannerImage}');` : ""}`}
        data-has-image={bannerImage ? "true" : "false"}
      >
        <div class="cat-banner-inner">
          <h1 class="cat-title">{getCategoryLabel(navCategory!, lang)}</h1>
          {getCategorySlogan(navCategory!, lang) && (
            <p class="cat-slogan">{getCategorySlogan(navCategory!, lang)}</p>
          )}
        </div>
      </section>

      {supplierLogos.length > 0 && (
        <section class="supplier-strip" aria-label={lang === "el" ? "Οι προμηθευτές μας" : "Our suppliers"}>
          <ul>
            {supplierLogos.map((logo) => (
              <li>
                {logo.href ? (
                  <a href={logo.href} target="_blank" rel="noopener">
                    <img src={logo.src} alt={logo.alt} loading="lazy" />
                  </a>
                ) : (
                  <img src={logo.src} alt={logo.alt} loading="lazy" />
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      {subcategories.length > 0 && (
        <section class="subcat-section">
          <h2 class="section-heading">{t("collection.browseByCategory")}</h2>
          <div class="subcat-grid">
            {subcategories.map((sub) => (
              <a href={lp(`/collections/${sub.handle}`)} class="subcat-tile" style={`--accent: ${accent};`}>
                <div class="subcat-icon" aria-hidden="true">
                  {sub.icon ? (
                    <img src={sub.icon} alt="" />
                  ) : (
                    <span class="subcat-initial">{getSubLabel(sub, lang).charAt(0)}</span>
                  )}
                </div>
                <div class="subcat-meta">
                  <span class="subcat-label">{getSubLabel(sub, lang)}</span>
                  {getSubDescription(sub, lang) && (
                    <span class="subcat-desc">{getSubDescription(sub, lang)}</span>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {handle === "orthopedic-braces-supports" && products.length > 0 && (
        <section class="products-section">
          <h2 class="section-heading">{t("collection.allOrthopaedicProducts")}</h2>
          <div class="grid" id="swr-target">
            {products.map((product: any) => (
              <a class="card" href={lp(`/products/${product.handle}`)}>
                <div class="card-img-wrap">
                  {product.featuredImage ? (
                    <img
                      src={product.featuredImage.url}
                      alt={product.featuredImage.altText || product.title}
                    />
                  ) : (
                    <div class="card-img-placeholder" />
                  )}
                </div>
                <div class="info">
                  <h3 class="card-title">{product.title}</h3>
                  <span class={"stock-pill " + (product.availableForSale ? "in" : "out")}>
                    {product.availableForSale ? t("card.inStock") : t("card.outOfStock")}
                  </span>
                  {isQuoteCollection ? (
                    <p class="price price-quote-card">{t("product.contactForQuote")}</p>
                  ) : (
                    <p class="price">
                      {product.priceRange.minVariantPrice.currencyCode}{" "}
                      {parseFloat(product.priceRange.minVariantPrice.amount).toFixed(2)}
                    </p>
                  )}
                  <div class="card-cta">
                    {t("collection.viewProduct")}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="14" height="14">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </>
  ) : (
    <>
      <a href={lp("/")} class="back">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="16" height="16">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
        {t("collection.backToProducts")}
      </a>
      <h1>{pageTitle}</h1>
      {safeDescription && <p class="desc">{safeDescription}</p>}
      <div class="grid" id="swr-target">
        {products.map((product: any) => (
          <a class="card" href={lp(`/products/${product.handle}`)}>
            <div class="card-img-wrap">
              {product.featuredImage ? (
                <img
                  src={product.featuredImage.url}
                  alt={product.featuredImage.altText || product.title}
                />
              ) : (
                <div class="card-img-placeholder" />
              )}
            </div>
            <div class="info">
              <h2 class="card-title">{product.title}</h2>
              <span class={"stock-pill " + (product.availableForSale ? "in" : "out")}>
                {product.availableForSale ? t("card.inStock") : t("card.outOfStock")}
              </span>
              {isQuoteCollection ? (
                <p class="price price-quote-card">{t("product.contactForQuote")}</p>
              ) : (
                <p class="price">
                  {product.priceRange.minVariantPrice.currencyCode}{" "}
                  {parseFloat(product.priceRange.minVariantPrice.amount).toFixed(2)}
                </p>
              )}
              <div class="card-cta">
                {t("collection.viewProduct")}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="14" height="14">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </>
  )}
  <RecentlyViewed />
</Layout>

<style>
  /* ── Banner ── */
  .cat-banner {
    position: relative;
    min-height: 320px;
    border-radius: 16px;
    overflow: hidden;
    margin: 0 0 2rem;
    background-color: var(--accent, #1e3a5f);
    background-image: linear-gradient(135deg, color-mix(in oklab, var(--accent) 92%, black 8%) 0%, color-mix(in oklab, var(--accent) 70%, white 30%) 100%);
    color: #fff;
    isolation: isolate;
  }
  .cat-banner[data-has-image="true"] {
    background-image: var(--banner-image);
    background-size: cover;
    background-position: center;
  }
  .cat-banner[data-has-image="true"]::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.55) 100%);
    z-index: 0;
  }
  .cat-banner-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    z-index: 1;
  }
  .cat-banner.pos-top-left    .cat-banner-inner { justify-content: flex-start; align-items: flex-start; text-align: left;  }
  .cat-banner.pos-top-right   .cat-banner-inner { justify-content: flex-start; align-items: flex-end;   text-align: right; }
  .cat-banner.pos-bottom-left .cat-banner-inner { justify-content: flex-end;   align-items: flex-start; text-align: left;  }
  .cat-banner.pos-bottom-right .cat-banner-inner { justify-content: flex-end;  align-items: flex-end;   text-align: right; }

  .cat-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    max-width: 60%;
  }
  .cat-slogan {
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    font-weight: 500;
    opacity: 0.92;
    margin: 0.5rem 0 0;
    max-width: 60%;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  /* ── Supplier logos strip ── */
  .supplier-strip {
    margin: 0 0 2rem;
    padding: 1.1rem 1.25rem;
    background: #fff;
    border: 1px solid #eef0f7;
    border-radius: 12px;
  }
  .supplier-strip ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    align-items: center;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .supplier-strip img {
    max-height: 36px;
    max-width: 140px;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.75;
    transition: filter 0.2s, opacity 0.2s;
  }
  .supplier-strip a:hover img,
  .supplier-strip li:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  /* ── Section headings ── */
  .section-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 1.1rem;
    letter-spacing: -0.01em;
  }
  .subcat-section,
  .products-section {
    margin: 0 0 2.5rem;
  }

  /* ── Subcategory grid ── */
  .subcat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .subcat-tile {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .subcat-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(30, 58, 95, 0.1);
    border-color: var(--accent, #1e3a5f);
  }
  .subcat-icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 10px;
    background: color-mix(in oklab, var(--accent, #1e3a5f) 12%, white 88%);
    color: var(--accent, #1e3a5f);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .subcat-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }
  .subcat-initial {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .subcat-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .subcat-label {
    font-weight: 600;
    font-size: 0.95rem;
    color: #1a1a1a;
    line-height: 1.3;
  }
  .subcat-desc {
    font-size: 0.8rem;
    color: #667085;
    line-height: 1.4;
  }

  /* ── Legacy simple layout (subcategory pages) ── */
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    color: #1e3a5f;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }
  .back:hover { color: #2563eb; }
  h1:not(.cat-title) {
    margin-bottom: 0.5rem;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
  }
  .desc {
    color: #555;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  /* ── Product grid ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid #e8edf3;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(30, 58, 95, 0.12);
  }
  .card-img-wrap {
    background: #f8fafc;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
  }
  .card-img-wrap img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    padding: 0.75rem;
    display: block;
    transition: transform 0.3s;
  }
  .card:hover .card-img-wrap img {
    transform: scale(1.04);
  }
  .card-img-placeholder {
    width: 100%;
    height: 180px;
    background: #e8edf3;
  }
  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid #f0f4f8;
  }
  .card-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.4;
    margin: 0 0 0.35rem 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .price {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1e3a5f;
    margin: 0 0 0.75rem 0;
  }
  .price-quote-card {
    font-size: 0.78rem;
    font-weight: 600;
    color: #1e3a5f;
    line-height: 1.3;
  }
  .stock-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.18rem 0.45rem;
    border-radius: 999px;
    margin-bottom: 0.4rem;
    align-self: flex-start;
  }
  .stock-pill.in  { background: #ecfdf5; color: #047857; }
  .stock-pill.out { background: #fef2f2; color: #b91c1c; }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e3a5f;
    transition: color 0.15s, gap 0.15s;
  }
  .card:hover .card-cta {
    color: #2d5a8e;
    gap: 0.5rem;
  }

  @media (max-width: 640px) {
    .cat-banner { min-height: 240px; }
    .cat-title { max-width: 85%; }
    .cat-slogan { max-width: 85%; }
  }
</style>
