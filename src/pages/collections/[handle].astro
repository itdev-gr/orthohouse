---
import Layout from "../../layouts/Layout.astro";
import {
  getCollections,
  getCollectionWithProducts,
  COLLECTION_PRODUCTS_QUERY,
} from "../../lib/shopify";

export async function getStaticPaths() {
  const collections = await getCollections();
  return collections.map((c: any) => ({ params: { handle: c.handle } }));
}

const { handle } = Astro.params;
const { collection, products } = await getCollectionWithProducts(handle!);

if (!collection) return Astro.redirect("/404");

// Shopify collection descriptions sometimes contain injected app/widget content
// (e.g. translation widgets whose text bleeds into the plain-text field).
// We hide the description if it looks like widget/script garbage rather than
// real copy: check for telltale patterns like language-list dumps or JS identifiers.
const WIDGET_PATTERNS = [
  /TRANSLATE\s+with/i,
  /LanguageMenu/,
  /langMenu\./,
  /EMBED THE SNIPPET/i,
  /Enable collaborative/i,
];
const rawDesc = collection.description ?? "";
const isGarbageDesc = WIDGET_PATTERNS.some((re) => re.test(rawDesc));
const safeDescription = isGarbageDesc ? "" : rawDesc;
---

<Layout
  title={collection.title}
  swrData={{
    query: COLLECTION_PRODUCTS_QUERY,
    variables: { handle, first: 50 },
    data: products,
    extract: "collection.products.nodes",
  }}
>
  <a href="/" class="back">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="16" height="16">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
    Back to products
  </a>
  <h1>{collection.title}</h1>
  {safeDescription && <p class="desc">{safeDescription}</p>}
  <div class="grid" id="swr-target">
    {products.map((product: any) => (
      <a class="card" href={`/products/${product.handle}`}>
        <div class="card-img-wrap">
          {product.featuredImage ? (
            <img
              src={product.featuredImage.url}
              alt={product.featuredImage.altText || product.title}
            />
          ) : (
            <div class="card-img-placeholder" />
          )}
        </div>
        <div class="info">
          <h2 class="card-title">{product.title}</h2>
          <p class="price">
            {product.priceRange.minVariantPrice.currencyCode}{" "}
            {parseFloat(product.priceRange.minVariantPrice.amount).toFixed(2)}
          </p>
          <div class="card-cta">
            View Product
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="14" height="14">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    color: #1e3a5f;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }
  .back:hover { color: #2563eb; }

  h1 {
    margin-bottom: 0.5rem;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
  }
  .desc {
    color: #555;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  /* ── Card ── */
  .card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid #e8edf3;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(30, 58, 95, 0.12);
  }

  /* ── Image area ── */
  .card-img-wrap {
    background: #f8fafc;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
  }
  .card-img-wrap img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    padding: 0.75rem;
    display: block;
    transition: transform 0.3s;
  }
  .card:hover .card-img-wrap img {
    transform: scale(1.04);
  }
  .card-img-placeholder {
    width: 100%;
    height: 180px;
    background: #e8edf3;
  }

  /* ── Info ── */
  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid #f0f4f8;
  }
  .card-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.4;
    margin: 0 0 0.35rem 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .price {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1e3a5f;
    margin: 0 0 0.75rem 0;
  }

  /* ── CTA ── */
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e3a5f;
    transition: color 0.15s, gap 0.15s;
  }
  .card:hover .card-cta {
    color: #2d5a8e;
    gap: 0.5rem;
  }
</style>
