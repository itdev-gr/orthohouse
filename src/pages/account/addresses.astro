---
import AccountLayout from "../../components/AccountLayout.astro";
import { pickLang, useTranslations, localizeHref } from "../../i18n/utils";

const lang = pickLang(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizeHref(p, lang);
---

<AccountLayout section="addresses" pageTitle={t("account.addresses.title")}>
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:0.5rem;flex-wrap:wrap;">
    <h1 class="acc-h1" style="margin:0;">{t("account.addresses.title")}</h1>
    <button id="addr-add" type="button" class="acc-btn">{t("account.addresses.add")}</button>
  </div>

  <div id="addr-alert" class="acc-alert" role="status" style="margin-top:1rem;"></div>

  <div id="addr-list" style="margin-top:1rem;display:grid;gap:0.85rem;"></div>

  <!-- Add / edit form, hidden until needed -->
  <dialog id="addr-dialog" style="border:none;border-radius:14px;padding:0;max-width:560px;width:90vw;box-shadow:0 18px 60px rgba(15,23,42,.28);">
    <form id="addr-form" class="acc-form" method="dialog" style="padding:1.5rem;max-width:none;">
      <h2 class="acc-section-title" id="addr-dialog-title" style="margin-top:0;">{t("account.addresses.add")}</h2>
      <input type="hidden" id="addr-id" name="id" />
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.65rem;">
        <div class="acc-field">
          <label class="acc-label" for="addr-firstName">{t("account.addresses.form.firstName")}</label>
          <input class="acc-input" id="addr-firstName" name="firstName" required />
        </div>
        <div class="acc-field">
          <label class="acc-label" for="addr-lastName">{t("account.addresses.form.lastName")}</label>
          <input class="acc-input" id="addr-lastName" name="lastName" required />
        </div>
      </div>
      <div class="acc-field">
        <label class="acc-label" for="addr-company">{t("account.addresses.form.company")}</label>
        <input class="acc-input" id="addr-company" name="company" />
      </div>
      <div class="acc-field">
        <label class="acc-label" for="addr-address1">{t("account.addresses.form.address1")}</label>
        <input class="acc-input" id="addr-address1" name="address1" required />
      </div>
      <div class="acc-field">
        <label class="acc-label" for="addr-address2">{t("account.addresses.form.address2")}</label>
        <input class="acc-input" id="addr-address2" name="address2" />
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.65rem;">
        <div class="acc-field">
          <label class="acc-label" for="addr-city">{t("account.addresses.form.city")}</label>
          <input class="acc-input" id="addr-city" name="city" required />
        </div>
        <div class="acc-field">
          <label class="acc-label" for="addr-province">{t("account.addresses.form.province")}</label>
          <input class="acc-input" id="addr-province" name="province" />
        </div>
        <div class="acc-field">
          <label class="acc-label" for="addr-zip">{t("account.addresses.form.zip")}</label>
          <input class="acc-input" id="addr-zip" name="zip" required />
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.65rem;">
        <div class="acc-field">
          <label class="acc-label" for="addr-country">{t("account.addresses.form.country")}</label>
          <input class="acc-input" id="addr-country" name="country" value="Cyprus" required />
        </div>
        <div class="acc-field">
          <label class="acc-label" for="addr-phone">{t("account.addresses.form.phone")}</label>
          <input class="acc-input" id="addr-phone" name="phone" type="tel" />
        </div>
      </div>

      <div id="addr-form-alert" class="acc-alert acc-alert-error" role="alert" style="margin-top:0.5rem;"></div>

      <div style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:1rem;">
        <button type="button" id="addr-cancel" class="acc-btn acc-btn-ghost">{t("account.addresses.form.cancel")}</button>
        <button type="submit" id="addr-save" class="acc-btn">{t("account.addresses.form.save")}</button>
      </div>
    </form>
  </dialog>
</AccountLayout>

<script is:inline
  data-empty={t("account.addresses.empty")}
  data-edit={t("account.addresses.edit")}
  data-delete={t("account.addresses.delete")}
  data-make-default={t("account.addresses.makeDefault")}
  data-default-badge={t("account.addresses.defaultBadge")}
  data-add={t("account.addresses.add")}
  data-confirm-delete={t("account.addresses.confirmDelete")}
  data-err-generic={t("account.error.generic")}>
  (function () {
    var d = document.currentScript.dataset;
    var dialog = document.getElementById("addr-dialog");
    var form = document.getElementById("addr-form");
    var dialogTitle = document.getElementById("addr-dialog-title");
    var formAlert = document.getElementById("addr-form-alert");
    var listEl = document.getElementById("addr-list");
    var topAlert = document.getElementById("addr-alert");
    var saveBtn = document.getElementById("addr-save");

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c];
      });
    }

    function openDialog(title, address) {
      dialogTitle.textContent = title;
      formAlert.classList.remove("show");
      formAlert.textContent = "";
      var a = address || {};
      form.id.value = a.id || "";
      form.firstName.value = a.firstName || "";
      form.lastName.value = a.lastName || "";
      form.company.value = a.company || "";
      form.address1.value = a.address1 || "";
      form.address2.value = a.address2 || "";
      form.city.value = a.city || "";
      form.province.value = a.province || "";
      form.country.value = a.country || "Cyprus";
      form.zip.value = a.zip || "";
      form.phone.value = a.phone || "";
      if (typeof dialog.showModal === "function") dialog.showModal();
      else dialog.setAttribute("open", "");
    }
    function closeDialog() {
      if (typeof dialog.close === "function") dialog.close();
      else dialog.removeAttribute("open");
    }

    function render(c) {
      if (!c) { listEl.innerHTML = '<p class="acc-muted">…</p>'; return; }
      var addresses = c.addresses || [];
      var defaultId = c.defaultAddress && c.defaultAddress.id;
      if (addresses.length === 0) {
        listEl.innerHTML = '<p class="acc-muted">' + escapeHtml(d.empty) + '</p>';
        return;
      }
      listEl.innerHTML = addresses.map(function (a) {
        var lines = (a.formatted || []).map(escapeHtml).join("<br>");
        var isDefault = a.id === defaultId;
        return '<div class="acc-addr-card" style="border:1px solid #e8edf3;border-radius:10px;padding:1rem;display:grid;gap:0.4rem;">' +
          (isDefault ? '<span style="background:#ecfdf5;color:#047857;padding:0.15rem 0.5rem;border-radius:999px;font-size:0.7rem;font-weight:600;align-self:flex-start;">' + escapeHtml(d.defaultBadge) + '</span>' : "") +
          '<div style="font-size:0.92rem;line-height:1.5;">' + lines + '</div>' +
          '<div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.5rem;">' +
            '<button type="button" class="acc-btn acc-btn-ghost" data-edit-id="' + escapeHtml(a.id) + '" style="padding:0.45rem 0.85rem;font-size:0.85rem;">' + escapeHtml(d.edit) + '</button>' +
            (isDefault ? "" : '<button type="button" class="acc-btn acc-btn-ghost" data-default-id="' + escapeHtml(a.id) + '" style="padding:0.45rem 0.85rem;font-size:0.85rem;">' + escapeHtml(d.makeDefault) + '</button>') +
            '<button type="button" class="acc-btn acc-btn-danger" data-delete-id="' + escapeHtml(a.id) + '" style="padding:0.45rem 0.85rem;font-size:0.85rem;">' + escapeHtml(d.delete) + '</button>' +
          '</div>' +
        '</div>';
      }).join("");
    }

    function findAddress(id) {
      var c = window.__customer;
      if (!c) return null;
      return (c.addresses || []).find(function (a) { return a.id === id; }) || null;
    }

    function ready(fn) {
      if (document.readyState !== "loading") fn();
      else document.addEventListener("DOMContentLoaded", fn);
    }
    ready(function () {
      if (window.__customer) render(window.__customer);
      document.addEventListener("customer:changed", function (e) { render(e.detail); });
      if (window.Customer) window.Customer.refresh();

      document.getElementById("addr-add").addEventListener("click", function () { openDialog(d.add, null); });
      document.getElementById("addr-cancel").addEventListener("click", function (e) { e.preventDefault(); closeDialog(); });

      listEl.addEventListener("click", function (e) {
        var editBtn = e.target.closest("[data-edit-id]");
        var defaultBtn = e.target.closest("[data-default-id]");
        var deleteBtn = e.target.closest("[data-delete-id]");
        if (editBtn) { openDialog(d.edit, findAddress(editBtn.dataset.editId)); return; }
        if (defaultBtn) {
          window.Customer.setDefaultAddress(defaultBtn.dataset.defaultId).catch(function (err) {
            console.error(err);
            topAlert.classList.add("show", "acc-alert-error");
            topAlert.textContent = (err && err.message) || d.errGeneric;
          });
          return;
        }
        if (deleteBtn) {
          if (!window.confirm(d.confirmDelete)) return;
          window.Customer.deleteAddress(deleteBtn.dataset.deleteId).catch(function (err) {
            console.error(err);
            topAlert.classList.add("show", "acc-alert-error");
            topAlert.textContent = (err && err.message) || d.errGeneric;
          });
        }
      });

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        formAlert.classList.remove("show");
        formAlert.textContent = "";
        if (!window.Customer) return;
        var id = form.id.value || null;
        var address = {
          firstName: form.firstName.value.trim(),
          lastName: form.lastName.value.trim(),
          company: form.company.value.trim() || null,
          address1: form.address1.value.trim(),
          address2: form.address2.value.trim() || null,
          city: form.city.value.trim(),
          province: form.province.value.trim() || null,
          country: form.country.value.trim(),
          zip: form.zip.value.trim(),
          phone: form.phone.value.trim() || null,
        };
        // Clean nulls — Shopify wants the field omitted, not nulled
        Object.keys(address).forEach(function (k) { if (address[k] === null || address[k] === "") delete address[k]; });
        saveBtn.disabled = true;
        var op = id ? window.Customer.updateAddress(id, address) : window.Customer.addAddress(address);
        op.then(function () { closeDialog(); })
          .catch(function (err) {
            console.error("Address save failed:", err);
            formAlert.classList.add("show");
            formAlert.textContent = (err && err.message) || d.errGeneric;
          })
          .finally(function () { saveBtn.disabled = false; });
      });
    });
  })();
</script>
