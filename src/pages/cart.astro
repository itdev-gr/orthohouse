---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cart">
  <h1 class="page-title">Your Cart</h1>

  <div id="cart-container">
    <div id="cart-loading" class="cart-empty">
      <p>Loading cart…</p>
    </div>
    <div id="cart-empty" class="cart-empty" style="display:none">
      <p>Your cart is empty.</p>
      <a href="/" class="continue-link">&larr; Continue shopping</a>
    </div>
    <div id="cart-content" style="display:none">
      <div id="cart-lines"></div>
      <div class="cart-footer">
        <div class="subtotal">
          <span>Subtotal</span>
          <span id="cart-subtotal" class="subtotal-amount"></span>
        </div>
        <p class="shipping-note">Shipping calculated at checkout</p>
        <button type="button" id="checkout-btn" class="checkout-btn">Checkout</button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-title {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }
  .cart-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: #666;
  }
  .continue-link {
    display: inline-block;
    margin-top: 1rem;
    color: #2563eb;
    text-decoration: none;
  }
  .continue-link:hover { text-decoration: underline; }

  /* Line items */
  :global(.cart-line) {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid #e5e5e5;
  }
  :global(.cart-line-img) {
    width: 100px;
    height: 100px;
    border-radius: 8px;
    object-fit: contain;
    background: #fff;
    flex-shrink: 0;
  }
  :global(.cart-line-info) {
    flex: 1;
    min-width: 0;
  }
  :global(.cart-line-title) {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  :global(.cart-line-variant) {
    font-size: 0.875rem;
    color: #666;
    margin-bottom: 0.5rem;
  }
  :global(.cart-line-price) {
    font-weight: 600;
    color: #2563eb;
    margin-bottom: 0.5rem;
  }
  :global(.qty-controls) {
    display: inline-flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    overflow: hidden;
  }
  :global(.qty-btn) {
    width: 32px;
    height: 32px;
    border: none;
    background: #fff;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.1s;
  }
  :global(.qty-btn:hover) { background: #f3f4f6; }
  :global(.qty-value) {
    width: 36px;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
    border-left: 1px solid #d1d5db;
    border-right: 1px solid #d1d5db;
    line-height: 32px;
  }
  :global(.remove-btn) {
    margin-left: 0.75rem;
    background: none;
    border: none;
    color: #9ca3af;
    cursor: pointer;
    font-size: 0.8rem;
    transition: color 0.15s;
  }
  :global(.remove-btn:hover) { color: #ef4444; }

  /* Footer */
  .cart-footer {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid #e5e5e5;
    text-align: right;
  }
  .subtotal {
    display: flex;
    justify-content: space-between;
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .subtotal-amount { color: #2563eb; }
  .shipping-note {
    font-size: 0.8rem;
    color: #888;
    margin-bottom: 1rem;
  }
  .checkout-btn {
    display: inline-block;
    padding: 0.75rem 2.5rem;
    background: #2563eb;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .checkout-btn:hover { background: #1d4ed8; }
</style>

<script is:inline>
(function () {
  var loadingEl = document.getElementById("cart-loading");
  var emptyEl = document.getElementById("cart-empty");
  var contentEl = document.getElementById("cart-content");
  var linesEl = document.getElementById("cart-lines");
  var subtotalEl = document.getElementById("cart-subtotal");
  var checkoutBtn = document.getElementById("checkout-btn");

  function renderCart(cart) {
    loadingEl.style.display = "none";

    if (!cart || !cart.lines || cart.lines.edges.length === 0) {
      emptyEl.style.display = "";
      contentEl.style.display = "none";
      return;
    }

    emptyEl.style.display = "none";
    contentEl.style.display = "";

    // Render line items
    var html = "";
    cart.lines.edges.forEach(function (edge) {
      var node = edge.node;
      var merch = node.merchandise;
      var price = parseFloat(merch.price.amount).toFixed(2);
      var imgHtml = merch.image
        ? '<img class="cart-line-img" src="' + merch.image.url + '" alt="' + (merch.image.altText || merch.product.title).replace(/"/g, "&quot;") + '">'
        : "";

      html += '<div class="cart-line" data-line-id="' + node.id + '">'
        + imgHtml
        + '<div class="cart-line-info">'
        + '<div class="cart-line-title">' + merch.product.title + '</div>'
        + '<div class="cart-line-variant">' + merch.title + '</div>'
        + '<div class="cart-line-price">' + merch.price.currencyCode + ' ' + price + '</div>'
        + '<div class="qty-controls">'
        + '<button type="button" class="qty-btn" data-action="dec" data-line-id="' + node.id + '" data-qty="' + node.quantity + '">&minus;</button>'
        + '<span class="qty-value">' + node.quantity + '</span>'
        + '<button type="button" class="qty-btn" data-action="inc" data-line-id="' + node.id + '" data-qty="' + node.quantity + '">+</button>'
        + '</div>'
        + '<button type="button" class="remove-btn" data-line-id="' + node.id + '">Remove</button>'
        + '</div>'
        + '</div>';
    });
    linesEl.innerHTML = html;

    // Subtotal
    var sub = cart.cost && cart.cost.subtotalAmount;
    if (sub) {
      subtotalEl.textContent = sub.currencyCode + " " + parseFloat(sub.amount).toFixed(2);
    }
  }

  // Initial render once cart loads
  function tryRender() {
    if (window.__cart) {
      renderCart(window.__cart);
    }
  }

  // Listen for cart updates
  document.addEventListener("cart:updated", function (e) {
    renderCart(e.detail);
  });

  // Quantity and remove handlers (event delegation)
  linesEl.addEventListener("click", function (e) {
    var btn = e.target.closest("[data-action]");
    if (btn) {
      var lineId = btn.dataset.lineId;
      var qty = parseInt(btn.dataset.qty, 10);
      if (btn.dataset.action === "inc") {
        Cart.updateLine(lineId, qty + 1);
      } else if (btn.dataset.action === "dec") {
        if (qty > 1) {
          Cart.updateLine(lineId, qty - 1);
        } else {
          Cart.removeLines([lineId]);
        }
      }
      return;
    }

    var removeBtn = e.target.closest(".remove-btn");
    if (removeBtn) {
      Cart.removeLines([removeBtn.dataset.lineId]);
    }
  });

  // Checkout
  checkoutBtn.addEventListener("click", function () {
    var url = Cart.getCheckoutUrl();
    if (url) window.location.href = url;
  });

  // If cart.js already loaded and resolved, render immediately; otherwise wait for event
  tryRender();
})();
</script>
