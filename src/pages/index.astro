                     href={lp("/collections/wheelchairs")}>{lang === "el" ? "Δείτε την Συλλογή" : "View Collection"}</a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Slide 3: Walking Aids (image RIGHT) -->
        <div class="intro-carousel__slide" role="group"
             aria-roledescription="slide"
             aria-label={lang === "el" ? "Διαφάνεια 3 από 3" : "Slide 3 of 3"}>
          <div class="intro-row" aria-labelledby="carousel-walking-aids-intro-title">
            <div class="intro-row__inner">
              <div class="intro-row__text">
                <h2 id="carousel-walking-aids-intro-title" class="intro-row__title">{lang === "el" ? "Βοηθήματα Βάδισης" : "Walking Aids"}</h2>
                <p class="intro-row__body">
                  {lang === "el"
                    ? "Πατερίτσες, περιπατητές, rollators και μπαστούνια — τα βοηθήματα βάδισης δίνουν την αυτοπεποίθηση να κινείστε με ασφάλεια σε κάθε βήμα. Επιλέγουμε προϊόντα που συνδυάζουν εργονομικό σχεδιασμό, σταθερότητα και ελαφρύ βάρος, ώστε να ξανακερδίσετε την ανεξαρτησία σας στο σπίτι και έξω από αυτό."
                    : "Crutches, walkers, rollators, and canes — walking aids give you the confidence to move safely with every step. We curate products that combine ergonomic design, stability, and lightweight construction so you can reclaim your independence both at home and out and about."}
                </p>
                <div class="intro-row__actions">
                  <a class="intro-row__btn intro-row__btn--filled"
                     href={lp("/collections/walking-aids")}>{lang === "el" ? "Μάθετε Περισσότερα" : "Learn More"}</a>
                  <a class="intro-row__btn intro-row__btn--outline"
                     href={lp("/collections/walking-aids")}>{lang === "el" ? "Δείτε την Συλλογή" : "View Collection"}</a>
                </div>
              </div>

              <div class="intro-row__visual" aria-hidden="true">
                <span class="intro-row__halo"></span>
                <img class="intro-row__photo"
                     src="/images/categories/walking-aids.webp"
                     alt=""
                     width="1000" height="1000"
                     loading="lazy" decoding="async" />
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Controls: prev · dots · next -->
    <div class="intro-carousel__controls">
      <button type="button" class="intro-carousel__arrow" id="intro-carousel-prev"
              aria-label={lang === "el" ? "Προηγούμενη διαφάνεια" : "Previous slide"}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/>
        </svg>
      </button>
      <div class="intro-carousel__dots" id="intro-carousel-dots">
        <button type="button" class="intro-carousel__dot active" data-slide="0"
                aria-label={`${lang === "el" ? "Διαφάνεια" : "Slide"} 1`}></button>
        <button type="button" class="intro-carousel__dot" data-slide="1"
                aria-label={`${lang === "el" ? "Διαφάνεια" : "Slide"} 2`}></button>
        <button type="button" class="intro-carousel__dot" data-slide="2"
                aria-label={`${lang === "el" ? "Διαφάνεια" : "Slide"} 3`}></button>
      </div>
      <button type="button" class="intro-carousel__arrow" id="intro-carousel-next"
              aria-label={lang === "el" ? "Επόμενη διαφάνεια" : "Next slide"}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16">
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
        </svg>
      </button>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       WHEELCHAIRS INTRO  (image LEFT)
       ══════════════════════════════════════ -->
  <section class="intro-row" aria-labelledby="wheelchairs-intro-title">
    <div class="intro-row__inner intro-row__inner--image-left">
      <div class="intro-row__visual" aria-hidden="true">
        <span class="intro-row__halo"></span>
        <img class="intro-row__photo"
             src="/images/categories/wheelchairs.webp"
             alt=""
             width="1000" height="1000"
             loading="lazy" decoding="async" />
      </div>
      <div class="intro-row__text">
        <h2 id="wheelchairs-intro-title" class="intro-row__title">{lang === "el" ? "Αναπηρικά Αμαξίδια" : "Wheelchairs"}</h2>
        <p class="intro-row__body">
          {lang === "el"
            ? "Από χειροκίνητα αμαξίδια μέχρι ηλεκτρικές λύσεις, προσφέρουμε ένα πλήρες φάσμα αναπηρικών αμαξιδίων σχεδιασμένων για άνεση, σταθερότητα και αξιοπιστία. Είτε χρειάζεστε ένα ελαφρύ αμαξίδιο μεταφοράς, είτε ένα προσαρμοσμένο σύστημα καθίσματος, η ομάδα μας σας βοηθά να βρείτε τη σωστή λύση που ταιριάζει στις καθημερινές σας ανάγκες."
            : "From manual chairs to powered solutions, we offer a complete range of wheelchairs designed for comfort, stability, and reliability. Whether you need a lightweight transport chair or a fully customized seating system, our team helps you find the right fit for your daily life."}
        </p>
        <div class="intro-row__actions">
          <a class="intro-row__btn intro-row__btn--filled"
             href={lp("/collections/wheelchairs")}>{lang === "el" ? "Μάθετε Περισσότερα" : "Learn More"}</a>
          <a class="intro-row__btn intro-row__btn--outline"
             href={lp("/collections/wheelchairs")}>{lang === "el" ? "Δείτε την Συλλογή" : "View Collection"}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       WALKING AIDS INTRO  (image RIGHT)
       ══════════════════════════════════════ -->
  <section class="intro-row" aria-labelledby="walking-aids-intro-title">
    <div class="intro-row__inner">
      <div class="intro-row__text">
        <h2 id="walking-aids-intro-title" class="intro-row__title">{lang === "el" ? "Βοηθήματα Βάδισης" : "Walking Aids"}</h2>
        <p class="intro-row__body">
          {lang === "el"
            ? "Πατερίτσες, περιπατητές, rollators και μπαστούνια — τα βοηθήματα βάδισης δίνουν την αυτοπεποίθηση να κινείστε με ασφάλεια σε κάθε βήμα. Επιλέγουμε προϊόντα που συνδυάζουν εργονομικό σχεδιασμό, σταθερότητα και ελαφρύ βάρος, ώστε να ξανακερδίσετε την ανεξαρτησία σας στο σπίτι και έξω από αυτό."
            : "Crutches, walkers, rollators, and canes — walking aids give you the confidence to move safely with every step. We curate products that combine ergonomic design, stability, and lightweight construction so you can reclaim your independence both at home and out and about."}
        </p>
        <div class="intro-row__actions">
          <a class="intro-row__btn intro-row__btn--filled"
             href={lp("/collections/walking-aids")}>{lang === "el" ? "Μάθετε Περισσότερα" : "Learn More"}</a>
          <a class="intro-row__btn intro-row__btn--outline"
             href={lp("/collections/walking-aids")}>{lang === "el" ? "Δείτε την Συλλογή" : "View Collection"}</a>
        </div>
      </div>

      <div class="intro-row__visual" aria-hidden="true">
        <span class="intro-row__halo"></span>
        <img class="intro-row__photo"
             src="/images/categories/walking-aids.webp"
             alt=""
             width="1000" height="1000"
             loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       ORTHOPAEDIC SHOWCASE
       ══════════════════════════════════════ -->
  <section class="ortho-section">

    <!-- ── LEFT: human body image + dot markers ── -->
    <div class="ortho-left">
      <div class="body-map-wrap">
        <img class="human-img" src="/humanbody-1.webp" alt="Orthopaedic human body illustration" width="1000" height="1000" loading="lazy"/>
        <div class="body-map-overlay" aria-hidden="true">
          <div class="body-dot" data-handle="head"                 style="left:50%;top:9%"><span class="dot-label">{lang === "el" ? "Κεφάλι" : "Head"}</span></div>
          <div class="body-dot" data-handle="cervical"             style="left:50%;top:16%"><span class="dot-label">{lang === "el" ? "Αυχένας" : "Neck"}</span></div>
          <div class="body-dot" data-handle="shoulder"             style="left:35%;top:23%"><span class="dot-label">{lang === "el" ? "Ώμος" : "Shoulder"}</span></div>
          <div class="body-dot" data-handle="thoracic"             style="left:50%;top:32%"><span class="dot-label">{lang === "el" ? "Θώρακας" : "Thoracic"}</span></div>
          <div class="body-dot" data-handle="elbow"                style="left:22%;top:22%"><span class="dot-label">{lang === "el" ? "Αγκώνας" : "Elbow"}</span></div>
          <div class="body-dot" data-handle="upper-limb"           style="left:78%;top:26%"><span class="dot-label">{lang === "el" ? "Άνω Άκρο" : "Upper Limb"}</span></div>
          <div class="body-dot" data-handle="wrist-thumb-supports" style="left:10%;top:22%"><span class="dot-label">{lang === "el" ? "Καρπός & Αντίχειρας" : "Wrist & Thumb"}</span></div>
          <div class="body-dot" data-handle="hand"                 style="left:93%;top:22%"><span class="dot-label">{lang === "el" ? "Χέρι" : "Hand"}</span></div>
          <div class="body-dot" data-handle="fingers"              style="left:7%;top:23%"><span class="dot-label">{lang === "el" ? "Δάκτυλα" : "Fingers"}</span></div>
          <div class="body-dot" data-handle="lumbar"               style="left:50%;top:47%"><span class="dot-label">{lang === "el" ? "Οσφύς" : "Lumbar"}</span></div>
          <div class="body-dot" data-handle="trunk-lumbar-supports"style="left:43%;top:42%"><span class="dot-label">{lang === "el" ? "Κορμός & Οσφύς" : "Trunk & Lumbar"}</span></div>
          <div class="body-dot" data-handle="hip"                  style="left:42%;top:54%"><span class="dot-label">{lang === "el" ? "Ισχίο" : "Hip"}</span></div>
          <div class="body-dot" data-handle="thigh"                style="left:42%;top:64%"><span class="dot-label">{lang === "el" ? "Μηρός" : "Thigh"}</span></div>
          <div class="body-dot" data-handle="lower-limb"           style="left:58%;top:64%"><span class="dot-label">{lang === "el" ? "Κάτω Άκρο" : "Lower Limb"}</span></div>
          <div class="body-dot" data-handle="knee"                 style="left:42%;top:73%"><span class="dot-label">{lang === "el" ? "Γόνατο" : "Knee"}</span></div>
          <div class="body-dot" data-handle="knee-braces"          style="left:58%;top:73%"><span class="dot-label">{lang === "el" ? "Νάρθηκες Γόνατος" : "Knee Braces"}</span></div>
          <div class="body-dot" data-handle="calf"                 style="left:42%;top:82%"><span class="dot-label">{lang === "el" ? "Κνήμη" : "Calf"}</span></div>
          <div class="body-dot" data-handle="ankle"                style="left:58%;top:90%"><span class="dot-label">{lang === "el" ? "Αστράγαλος" : "Ankle"}</span></div>
          <div class="body-dot" data-handle="foot"                 style="left:42%;top:94%"><span class="dot-label">{lang === "el" ? "Πέλμα" : "Foot"}</span></div>
          <div class="body-dot" data-handle="orthopedic-insoles"   style="left:58%;top:94%"><span class="dot-label">{lang === "el" ? "Ορθοπεδικοί Πάτοι" : "Orthopedic Insoles"}</span></div>
        </div>
      </div>
    </div>

    <!-- ── RIGHT: product slider + banner ── -->
    <div class="ortho-right">

      <div class="ortho-header">
        <h2 class="ortho-title" id="ortho-title">{t("home.ortho.title")}</h2>
        <p class="ortho-subtitle" id="ortho-subtitle">{t("home.ortho.subtitle")}</p>
      </div>

      <!-- Slider -->
      <div class="ortho-slider-wrap">
        <div class="ortho-track" id="ortho-track">
          {orthoSlides.map((slide) => (
            <div class="ortho-slide">
              {slide.map((p: any) => {
                const v = p.variants?.nodes?.[0];
                const price = parseFloat(v?.price?.amount ?? p.priceRange?.minVariantPrice?.amount ?? "0");
                const compareAt = parseFloat(v?.compareAtPrice?.amount ?? "0");
                const currency = v?.price?.currencyCode ?? p.priceRange?.minVariantPrice?.currencyCode ?? "EUR";
                const isAvail = v?.availableForSale ?? true;
                const isSale = compareAt > 0 && compareAt > price;
                return (
                  <a href={lp(`/products/${p.handle}`)} class="ortho-card">
                    {isSale && <span class="ortho-badge">{lang === "el" ? "Προσφορά" : "Sale"}</span>}
                    <div class="ortho-card-img">
                      {p.featuredImage
                        ? <img src={shopifyThumb(p.featuredImage.url, 300)} alt={p.featuredImage.altText || p.title} width="300" height="300" loading="lazy"/>
                        : <div class="ortho-card-no-img"/>}
                    </div>
                    <div class="ortho-card-body">
                      <p class="ortho-card-name">{p.title}</p>
                      <div class="ortho-price-row">
                        {isSale && <s class="ortho-compare">{currency} {compareAt.toFixed(2)}</s>}
                        <span class={`ortho-price${isSale ? " sale" : ""}`}>{currency} {price.toFixed(2)}</span>
                      </div>
                      <span class={`ortho-avail${isAvail ? " in" : " out"}`}>
                        ● {isAvail ? (lang === "el" ? "Διαθέσιμο" : "In Stock") : (lang === "el" ? "Εξαντλημένο" : "Out of Stock")}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          ))}
        </div>
      </div>

      <!-- Controls: prev · dots · next -->
      <div class="ortho-controls">
        <button type="button" class="ortho-arrow" id="ortho-prev" aria-label={lang === "el" ? "Προηγούμενη διαφάνεια" : "Previous slide"}>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/>
          </svg>
        </button>
