       HERO BANNER
       ══════════════════════════════════════ -->
  <div class="hero-banner">
    <img
      src="/hero-768.webp"
      srcset="/hero-480.webp 480w, /hero-768.webp 768w, /hero-1200.webp 1200w, /ChatGPT_Image_Nov_25_2025_10_06_16_PM.webp 1680w"
      sizes="100vw"
      alt="OrthoHouse Cyprus"
      width="1680" height="1200"
      fetchpriority="high" decoding="async"
