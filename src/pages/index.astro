---
import Layout from "../layouts/Layout.astro";
import { getProducts, PRODUCTS_QUERY, getCollectionPreview } from "../lib/shopify";
import { NAV_CATEGORIES, getCategoryLabel, getSubLabel, getSubDescription } from "../lib/menuConfig";
import { pickLang, useTranslations, localizeHref } from "../i18n/utils";

const lang = pickLang(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizeHref(p, lang);

const products = await getProducts(12);

// Orthopaedic showcase — 9 products → 3 slides of 3
const orthoRaw = await getCollectionPreview("orthopedic-braces-supports", 9);
const orthoSlides: any[][] = [];
for (let i = 0; i < orthoRaw.length; i += 3) {
  orthoSlides.push(orthoRaw.slice(i, i + 3));
}

// ── Body-dot category products — fetched at build time ──────────────────
const BODY_HANDLES = [
  "head","cervical","shoulder","thoracic","elbow","upper-limb",
  "wrist-thumb-supports","hand","fingers","lumbar",
  "trunk-lumbar-supports","hip","thigh","lower-limb","knee",
  "knee-braces","calf","ankle","foot","orthopedic-insoles"
] as const;

const catResults = await Promise.all(
  BODY_HANDLES.map(h => getCollectionPreview(h, 9).catch(() => []))
);

const catProductMap: Record<string, any[]> = {};
BODY_HANDLES.forEach((h, i) => { catProductMap[h] = catResults[i]; });

function shopifyThumb(url: string, w = 300) {
  if (!url) return url;
  const sep = url.includes('?') ? '&' : '?';
  return `${url}${sep}width=${w}`;
}

const catDataJSON = JSON.stringify(
  Object.fromEntries(
    Object.entries(catProductMap).map(([handle, prods]) => [
      handle,
      (prods as any[]).map((p: any) => {
        const v     = p.variants?.nodes?.[0];
        const price = parseFloat(v?.price?.amount ?? p.priceRange?.minVariantPrice?.amount ?? "0");
        const ca    = parseFloat(v?.compareAtPrice?.amount ?? "0");
        const cu    = v?.price?.currencyCode ?? p.priceRange?.minVariantPrice?.currencyCode ?? "EUR";
        const avail = v?.availableForSale ?? true;
        return {
          t:   p.title,
          h:   p.handle,
          p:   price,
          ca:  ca > price ? ca : 0,
          cu,
          a:   avail,
          img: p.featuredImage?.url ?? "",
          alt: p.featuredImage?.altText ?? p.title,
        };
      })
    ])
  )
);
---

<Layout
  title="OrthoHouse Cyprus"
  swrData={{
    query: PRODUCTS_QUERY,
    variables: { first: 12 },
    data: products,
    extract: "products.nodes",
  }}
>
