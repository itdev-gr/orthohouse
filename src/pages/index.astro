  }
  .trust-icon {
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }
  .trust-text {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }
  .trust-label {
    font-size: 1.08rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.2;
  }
  .trust-sub {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.3;
  }
  .trust-divider {
    width: 1px;
    height: 53px;
    background: rgba(255, 255, 255, 0.18);
    flex-shrink: 0;
  }
  @media (max-width: 768px) {
    .trust-divider { display: none; }
    .trust-bar-inner { gap: 1.5rem; }
    .trust-item { min-width: 168px; }
  }
  @media (max-width: 480px) {
    .trust-item { min-width: calc(50% - 0.75rem); }
    .trust-label { font-size: 0.98rem; }
    .trust-sub   { font-size: 0.84rem; }
  }

  /* ══════════════════════════════════════
     HERO BANNER
     ══════════════════════════════════════ */
  .hero-banner {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    margin-top: -2rem;
    line-height: 0;
    overflow: hidden;
  }
  .hero-banner img {
    width: 100%;
    height: 520px;
    display: block;
    object-fit: cover;
    object-position: center center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(0,0,0,0.35) 100%
    );
  }
  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 3rem;
  }
  .hero-tagline {
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.3;
    text-shadow: 0 2px 12px rgba(0,0,0,0.35);
  }
  @media (max-width: 768px) {
    .hero-banner img { height: 320px; }
    .hero-tagline { font-size: 1.25rem; }
    .hero-content { padding-bottom: 2rem; }
  }

  /* ══════════════════════════════════════
     CATEGORY BENTO SECTION
     ══════════════════════════════════════ */
  .cat-section {
    margin-bottom: 3rem;
  }

  .cat-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  /* ── 3 × 3 grid for 9 categories ── */
  .cat-bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 220px;
    gap: 14px;
  }

  /* ── Base card ── */
  .cat-card {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    text-decoration: none;
    display: block;
    cursor: pointer;
    background: var(--accent, #1e3a5f);
    background-image: linear-gradient(
      135deg,
      color-mix(in oklab, var(--accent) 88%, black 12%) 0%,
      color-mix(in oklab, var(--accent) 65%, white 35%) 100%
    );
    isolation: isolate;
  }
  .cat-card[data-has-image="true"] {
    background: #1a1a1a;
    background-image: none;
  }

  /* ── Background image ── */
  .cat-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.55s ease;
    will-change: transform;
  }
  .cat-card:hover .cat-img {
    transform: scale(1.07);
  }

  /* ── Dark gradient overlay ── */
  .cat-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(8, 22, 42, 0.78) 0%,
      rgba(8, 22, 42, 0.32) 45%,
      rgba(8, 22, 42, 0.10) 100%
    );
    transition: background 0.35s ease;
  }
  .cat-card:hover .cat-overlay {
    background: linear-gradient(
      to top,
      rgba(8, 22, 42, 0.88) 0%,
      rgba(8, 22, 42, 0.48) 50%,
      rgba(8, 22, 42, 0.20) 100%
    );
  }

  /* ── Text content (bottom-left) ── */
  .cat-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.6rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .cat-name {
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
  }

  .cat-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.80);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    transition: color 0.2s, gap 0.2s;
  }
  .cat-cta svg {
    transition: transform 0.22s;
    flex-shrink: 0;
  }
  .cat-card:hover .cat-cta {
    color: #fff;
    gap: 0.52rem;
  }
  .cat-card:hover .cat-cta svg {
    transform: translateX(3px);
  }

  /* ── Mobile: single column, one under the other ── */
  @media (max-width: 1024px) {
    .cat-bento {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 200px;
    }
  }
  @media (max-width: 640px) {
    .cat-bento {
      grid-template-columns: 1fr;
      grid-auto-rows: 180px;
      gap: 12px;
    }
    .cat-name {
      font-size: 1.15rem;
    }
  }

  /* ══════════════════════════════════════
     PRODUCTS HEADING & GRID
     ══════════════════════════════════════ */
  h1 {
    margin-bottom: 1.5rem;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  /* ── Card ── */
  .card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid #e8edf3;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(30, 58, 95, 0.12);
  }

  /* ── Image area ── */
  .card-img-wrap {
    background: #f8fafc;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
  }
  .card-img-wrap img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    padding: 0.75rem;
    display: block;
    transition: transform 0.3s;
  }
  .card:hover .card-img-wrap img {
    transform: scale(1.04);
  }
  .card-img-placeholder {
    width: 100%;
    height: 180px;
    background: #e8edf3;
  }

  /* ── Info ── */
  .info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid #f0f4f8;
  }
  .card-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.4;
    margin: 0 0 0.35rem 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .price {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1e3a5f;
    margin: 0 0 0.75rem 0;
  }

  /* ── CTA ── */
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e3a5f;
    transition: color 0.15s, gap 0.15s;
  }
  .card:hover .card-cta {
    color: #2d5a8e;
    gap: 0.5rem;
  }

  /* ══════════════════════════════════════
     ORTHOPAEDIC SHOWCASE
     ══════════════════════════════════════ */
  .ortho-section {
    display: grid;
    grid-template-columns: 50% 50%;
    gap: 0;
    margin-bottom: 3rem;
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 32px rgba(30, 58, 95, 0.08);
    border: 1px solid #e8edf3;
  }

  /* ── Left: human panel ── */
  .ortho-left {
    display: flex;
    align-items: stretch;
    min-height: 624px;
    /* overflow now on .body-map-wrap */
  }
  .human-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Body map wrapper ── */
  .body-map-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* ── Overlay ── */
  .body-map-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ── Individual dot ── */
  .body-dot {
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: auto;
    z-index: 10;
    cursor: default;
  }
  .body-dot::before {
    content: "";
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #2563eb;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px rgba(37,99,235,0.35), 0 2px 8px rgba(37,99,235,0.3);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    animation: dot-pulse 2.8s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes dot-pulse {
    0%,100% { box-shadow: 0 0 0 2px rgba(37,99,235,0.35), 0 2px 8px rgba(37,99,235,0.3); }
    50%      { box-shadow: 0 0 0 7px rgba(37,99,235,0.12), 0 2px 14px rgba(37,99,235,0.45); }
  }
  .body-dot:hover::before {
    transform: scale(1.5);
    box-shadow: 0 0 0 5px rgba(37,99,235,0.2), 0 4px 16px rgba(37,99,235,0.5);
    animation-play-state: paused;
  }

  /* ── Tooltip ── */
  .dot-label {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: rgba(15,23,42,0.9);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
    padding: 0.28rem 0.65rem;
    border-radius: 5px;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 20;
  }
  .dot-label::after {
    content: "";
    position: absolute;
    top: 100%; left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: rgba(15,23,42,0.9);
  }
  .body-dot:hover .dot-label {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* ── Selected dot — orange ring ── */
  .body-dot.dot-selected::before {
    background: #f97316;
    box-shadow: 0 0 0 3px rgba(249,115,22,0.35), 0 2px 12px rgba(249,115,22,0.45);
    animation-play-state: paused;
    transform: scale(1.4);
  }

  /* ── No-products fallback slide ── */
  .ortho-no-products {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    font-size: 0.9rem;
    color: #64748b;
    grid-column: 1 / -1;
  }
  .ortho-no-products a { color: #2563eb; text-decoration: underline; }

  /* Stagger pulse animation across all 20 dots */
  .body-dot:nth-child(1)  { --d: 0s    } .body-dot:nth-child(2)  { --d: 0.14s }
  .body-dot:nth-child(3)  { --d: 0.28s } .body-dot:nth-child(4)  { --d: 0.42s }
  .body-dot:nth-child(5)  { --d: 0.56s } .body-dot:nth-child(6)  { --d: 0.70s }
  .body-dot:nth-child(7)  { --d: 0.84s } .body-dot:nth-child(8)  { --d: 0.98s }
  .body-dot:nth-child(9)  { --d: 1.12s } .body-dot:nth-child(10) { --d: 1.26s }
  .body-dot:nth-child(11) { --d: 1.40s } .body-dot:nth-child(12) { --d: 1.54s }
  .body-dot:nth-child(13) { --d: 1.68s } .body-dot:nth-child(14) { --d: 1.82s }
  .body-dot:nth-child(15) { --d: 1.96s } .body-dot:nth-child(16) { --d: 2.10s }
  .body-dot:nth-child(17) { --d: 2.24s } .body-dot:nth-child(18) { --d: 2.38s }
  .body-dot:nth-child(19) { --d: 2.52s } .body-dot:nth-child(20) { --d: 2.66s }

  /* ── Right panel ── */
  .ortho-right {
    padding: 1.75rem 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  /* Header */
  .ortho-header {}
  .ortho-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 0.25rem;
    letter-spacing: -0.01em;
  }
  .ortho-subtitle {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0;
  }

  /* ── Slider ── */
  .ortho-slider-wrap {
    overflow: hidden;
    border-radius: 10px;
    flex: 1;
  }
  .ortho-track {
    display: flex;
    transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  .ortho-slide {
    min-width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  /* ── Product card ── */
  .ortho-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .ortho-card:hover {
    box-shadow: 0 8px 24px rgba(30, 58, 95, 0.12);
    transform: translateY(-2px);
  }
  .ortho-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #ef4444;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    border-radius: 4px;
    z-index: 1;
  }
  .ortho-card-img {
    background: #f8fafc;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ortho-card-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.5rem;
    transition: transform 0.3s;
  }
  .ortho-card:hover .ortho-card-img img {
    transform: scale(1.05);
  }
  .ortho-card-no-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #e8edf3;
  }
  .ortho-card-body {
    padding: 0.65rem 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }
  .ortho-card-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: #1a1a2e;
    margin: 0;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .ortho-price-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .ortho-compare {
    font-size: 0.7rem;
    color: #9ca3af;
  }
  .ortho-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e3a5f;
  }
  .ortho-price.sale {
    color: #dc2626;
  }
  .ortho-avail {
    font-size: 0.65rem;
    font-weight: 600;
  }
  .ortho-avail.in  { color: #16a34a; }
  .ortho-avail.out { color: #9ca3af; }

  /* ── Controls ── */
  .ortho-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .ortho-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid #d1d5db;
    background: #fff;
    color: #555;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .ortho-arrow:hover {
    border-color: #1e3a5f;
    background: #1e3a5f;
    color: #fff;
  }
  .ortho-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ortho-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: #d1d5db;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .ortho-dot.active {
    background: #1e3a5f;
    transform: scale(1.35);
  }

  /* ── Banner ── */
  .ortho-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 60%, #3b82f6 100%);
    border-radius: 12px;
    padding: 1.1rem 1.4rem;
    flex-shrink: 0;
  }
  .ortho-banner-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.65);
    margin: 0 0 0.2rem;
  }
  .ortho-banner-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.2rem;
  }
  .ortho-banner-sub {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.7);
    margin: 0;
  }
  .ortho-banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    background: #fff;
    color: #1e3a5f;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.6rem 1.1rem;
    border-radius: 8px;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.15s, color 0.15s;
  }
  .ortho-banner-btn:hover {
    background: #eff6ff;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .ortho-section {
      grid-template-columns: 1fr;
    }
    .ortho-left {
      min-height: auto;
      max-width: 420px;
      margin: 0 auto;
    }
    .body-map-wrap {
      aspect-ratio: 1 / 1;
    }
    .human-img {
      object-fit: cover;
    }
  }
  @media (max-width: 600px) {
    .ortho-slide {
      grid-template-columns: repeat(2, 1fr);
    }
    .ortho-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ══════════════════════════════════════
     INTRO ROW SECTIONS (Orthotics / Wheelchairs / Walking Aids)
     ══════════════════════════════════════ */
  .intro-row {
    max-width: 1280px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .intro-row__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }

  .intro-row__text {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 36rem;
  }

  .intro-row__title {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: #1a1a1a;
  }

  .intro-row__body {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #1a1a1a;
  }

  .intro-row__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.25rem;
  }

  .intro-row__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 2rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    border: 2px solid transparent;
  }

  .intro-row__btn--filled {
    background: #1e3a5f;
    color: #fff;
    border-color: #1e3a5f;
  }
  .intro-row__btn--filled:hover {
    background: #16294a;
    border-color: #16294a;
  }

  .intro-row__btn--outline {
    background: #fff;
    color: #1e3a5f;
    border-color: #1e3a5f;
  }
  .intro-row__btn--outline:hover {
