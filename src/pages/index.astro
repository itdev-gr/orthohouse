  <!-- New Products carousel logic -->
  <script is:inline>
  (function () {
    var NP_PER_SLIDE = 4;
    var track    = document.getElementById("newprod-track");
    var dotsWrap = document.getElementById("newprod-dots");
    var prevBtn  = document.getElementById("newprod-prev");
    var nextBtn  = document.getElementById("newprod-next");
    var tabsWrap = document.getElementById("newprod-tabs");
    if (!track) return;

    var current = 0;

    var npData = {};
    fetch("/data/newprod.json").then(function(r){return r.json()}).then(function(d){npData=d;}).catch(function(){});

    function getDots() { return dotsWrap ? Array.from(dotsWrap.querySelectorAll(".newprod-dot")) : []; }

    function esc(s) {
      return String(s).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    }

    function buildCard(p) {
      var isSale = p.ca > 0;
      return '<a href="/products/' + p.h + '" class="ortho-card">'
        + (isSale ? '<span class="ortho-badge">Sale</span>' : '')
        + '<div class="ortho-card-img">'
        + (p.img ? '<img src="' + esc(p.img + (p.img.indexOf('?')>-1?'&':'?') + 'width=300') + '" alt="' + esc(p.alt) + '" width="300" height="300" loading="lazy"/>'
                 : '<div class="ortho-card-no-img"></div>')
        + '</div><div class="ortho-card-body">'
        + '<p class="ortho-card-name">' + esc(p.t) + '</p>'
        + '<div class="ortho-price-row">'
        + (isSale ? '<s class="ortho-compare">' + esc(p.cu) + ' ' + p.ca.toFixed(2) + '</s>' : '')
        + '<span class="ortho-price' + (isSale ? ' sale' : '') + '">' + esc(p.cu) + ' ' + p.p.toFixed(2) + '</span>'
        + '</div>'
        + '<span class="ortho-avail' + (p.a ? ' in' : ' out') + '">● ' + (p.a ? 'In Stock' : 'Out of Stock') + '</span>'
        + '</div></a>';
    }

    function goTo(n) {
      var dots = getDots();
      var total = dots.length;
      if (!total) return;
      current = ((n % total) + total) % total;
      track.style.transform = "translateX(-" + (current * 100) + "%)";
      dots.forEach(function(d, i) { d.classList.toggle("active", i === current); });
    }

    function bindArrows() {
      if (prevBtn) prevBtn.onclick = function() { goTo(current - 1); };
      if (nextBtn) nextBtn.onclick = function() { goTo(current + 1); };
      getDots().forEach(function(d) {
        d.onclick = function() { goTo(parseInt(d.dataset.slide)); };
      });
    }

    function loadTab(handle) {
      var prods = npData[handle] || [];
      if (!prods.length) {
        track.innerHTML = '<div class="newprod-slide newprod-empty"><p>No products found in this category.</p></div>';
        dotsWrap.innerHTML = '<button class="newprod-dot active" data-slide="0"></button>';
        current = 0;
        track.style.transform = "translateX(0%)";
        bindArrows();
        return;
      }
      var slides = [];
      for (var i = 0; i < prods.length; i += NP_PER_SLIDE) slides.push(prods.slice(i, i + NP_PER_SLIDE));

      track.innerHTML = slides.map(function(sl) {
        return '<div class="newprod-slide">' + sl.map(buildCard).join('') + '</div>';
      }).join('');

      dotsWrap.innerHTML = slides.map(function(_, i) {
        return '<button class="newprod-dot' + (i === 0 ? ' active' : '')
          + '" data-slide="' + i + '" aria-label="Slide ' + (i + 1) + '"></button>';
      }).join('');

      current = 0;
      track.style.transform = "translateX(0%)";
      bindArrows();
    }

    // Tab click handlers
    if (tabsWrap) {
      tabsWrap.querySelectorAll(".newprod-tab").forEach(function(btn) {
        btn.addEventListener("click", function() {
          tabsWrap.querySelectorAll(".newprod-tab").forEach(function(b) { b.classList.remove("active"); });
          btn.classList.add("active");
          loadTab(btn.dataset.tab);
        });
      });
    }

    bindArrows();
  })();
  </script>

  <script is:inline>
  (function () {
    // ── Element refs ─────────────────────────────────────────────────────
    var track     = document.getElementById("ortho-track");
    var dotsWrap  = document.getElementById("ortho-dots");
    var prevBtn   = document.getElementById("ortho-prev");
    var nextBtn   = document.getElementById("ortho-next");
    var titleEl   = document.getElementById("ortho-title");
    var subEl     = document.getElementById("ortho-subtitle");
    var bannerBtn = document.getElementById("ortho-banner-btn");
    if (!track) return;

    var current = 0;

    // ── Category metadata ────────────────────────────────────────────────
    var CAT_META = {
      "head":                  { title: "Head Supports",             sub: "Helmets, head protection & orthotic aids" },
      "cervical":              { title: "Neck & Cervical Supports",  sub: "Collars and supports for neck pain relief" },
      "shoulder":              { title: "Shoulder Supports",         sub: "Stabilization and recovery solutions" },
      "thoracic":              { title: "Thoracic Supports",         sub: "Back braces for the upper spine & chest" },
      "elbow":                 { title: "Elbow Supports & Braces",   sub: "Relief for tennis elbow, sprains & injuries" },
      "upper-limb":            { title: "Upper Limb Supports",       sub: "Full arm supports from shoulder to wrist" },
      "wrist-thumb-supports":  { title: "Wrist & Thumb Supports",    sub: "Splints and braces for wrist stability" },
      "hand":                  { title: "Hand Supports",             sub: "Gloves, splints & post-op hand braces" },
      "fingers":               { title: "Finger Supports",           sub: "Finger splints, rings and buddy straps" },
      "lumbar":                { title: "Lumbar Supports",           sub: "Lower back belts for pain and posture" },
      "trunk-lumbar-supports": { title: "Trunk & Lumbar Supports",   sub: "Corsets and supports for the full trunk" },
      "hip":                   { title: "Hip Supports & Braces",     sub: "Post-surgical and orthotic hip supports" },
      "thigh":                 { title: "Thigh Supports",            sub: "Compression wraps and thigh sleeves" },
      "lower-limb":            { title: "Lower Limb Supports",       sub: "Full leg supports and orthoses" },
      "knee":                  { title: "Knee Supports & Braces",    sub: "Braces for knee pain, injuries & recovery" },
      "knee-braces":           { title: "Knee Braces",               sub: "Rigid and hinged braces for knee stability" },
      "calf":                  { title: "Calf Supports",             sub: "Compression sleeves and calf wraps" },
      "ankle":                 { title: "Ankle Supports & Braces",   sub: "Stabilizers for sprains and ankle injuries" },
      "foot":                  { title: "Foot Supports",             sub: "Orthotic insoles, drop foot & more" },
      "orthopedic-insoles":    { title: "Orthopedic Insoles",        sub: "Custom and off-the-shelf insole solutions" },
    };

    var DEFAULT_TITLE = "Orthopaedic Products";
    var DEFAULT_SUB   = "Premium supports & braces for every need";
    var DEFAULT_LINK  = "/collections/orthopedic-braces-supports";

    // ── Pre-fetched category product data ────────────────────────────────
    var catData = {};
    var catDataReady = fetch("/data/ortho-cat.json").then(function(r){return r.json()}).then(function(d){catData=d;}).catch(function(){});

    // ── Carousel helpers ─────────────────────────────────────────────────
    function getDots() {
      return dotsWrap ? Array.from(dotsWrap.querySelectorAll(".ortho-dot")) : [];
    }

    function goTo(n) {
      var dots = getDots();
      var total = dots.length;
      if (!total) return;
      current = ((n % total) + total) % total;
      track.style.transform = "translateX(-" + (current * 100) + "%)";
      dots.forEach(function(d, i) { d.classList.toggle("active", i === current); });
    }

    function bindArrows() {
      if (prevBtn) prevBtn.onclick = function() { goTo(current - 1); };
      if (nextBtn) nextBtn.onclick = function() { goTo(current + 1); };
      getDots().forEach(function(d) {
        d.addEventListener("click", function() { goTo(parseInt(d.dataset.slide)); });
      });
    }

    // ── HTML escape helper ───────────────────────────────────────────────
    function escHtml(s) {
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    // ── Card builder ─────────────────────────────────────────────────────
    function buildCard(p) {
      var isSale = p.ca > 0;
      var avail  = p.a;
      return '<a href="/products/' + p.h + '" class="ortho-card">'
        + (isSale ? '<span class="ortho-badge">Sale</span>' : '')
        + '<div class="ortho-card-img">'
        + (p.img
            ? '<img src="' + escHtml(p.img + (p.img.indexOf('?')>-1?'&':'?') + 'width=300') + '" alt="' + escHtml(p.alt) + '" width="300" height="300" loading="lazy"/>'
            : '<div class="ortho-card-no-img"></div>')
        + '</div>'
        + '<div class="ortho-card-body">'
        + '<p class="ortho-card-name">' + escHtml(p.t) + '</p>'
        + '<div class="ortho-price-row">'
        + (isSale ? '<s class="ortho-compare">' + escHtml(p.cu) + ' ' + p.ca.toFixed(2) + '</s>' : '')
        + '<span class="ortho-price' + (isSale ? ' sale' : '') + '">'
        + escHtml(p.cu) + ' ' + p.p.toFixed(2)
        + '</span>'
        + '</div>'
        + '<span class="ortho-avail' + (avail ? ' in' : ' out') + '">● '
        + (avail ? 'In Stock' : 'Out of Stock')
        + '</span>'
        + '</div></a>';
    }

    // ── Rebuild carousel with given product array ─────────────────────────
    function rebuildCarousel(prods) {
      // Chunk into slides of 3
      var slides = [];
      for (var i = 0; i < prods.length; i += 3) slides.push(prods.slice(i, i + 3));
      if (!slides.length) return false;

      // Rebuild track HTML
      track.innerHTML = slides.map(function(slide) {
        return '<div class="ortho-slide">' + slide.map(buildCard).join('') + '</div>';
      }).join('');

      // Rebuild pagination dots
      dotsWrap.innerHTML = slides.map(function(_, i) {
        return '<button type="button" class="ortho-dot' + (i === 0 ? ' active' : '')
          + '" data-slide="' + i + '" aria-label="Slide ' + (i + 1) + '"></button>';
      }).join('');

      current = 0;
      track.style.transform = "translateX(0%)";
      bindArrows();
      return true;
    }

    // ── Body dot: active-dot state ────────────────────────────────────────
    var activeBodyDot = null;
    // Store original track HTML so we can restore without a reload
    var defaultTrackHTML   = track.innerHTML;
    var defaultDotsHTML    = dotsWrap ? dotsWrap.innerHTML : "";

    // ── Body dot click handlers ──────────────────────────────────────────
    document.querySelectorAll(".body-dot[data-handle]").forEach(function(dot) {
      dot.style.cursor = "pointer";
      dot.addEventListener("click", function() {
        var handle = dot.dataset.handle;
        var prods  = catData[handle] || [];
        var meta   = CAT_META[handle] || { title: DEFAULT_TITLE, sub: DEFAULT_SUB };

        // Toggle: clicking the active dot resets to default
        if (activeBodyDot === dot) {
          activeBodyDot.classList.remove("dot-selected");
          activeBodyDot = null;
          if (titleEl)   titleEl.textContent = DEFAULT_TITLE;
          if (subEl)     subEl.textContent   = DEFAULT_SUB;
          if (bannerBtn) bannerBtn.href       = DEFAULT_LINK;
          // Restore original server-rendered HTML
          track.innerHTML  = defaultTrackHTML;
          if (dotsWrap) dotsWrap.innerHTML = defaultDotsHTML;
          current = 0;
          track.style.transform = "translateX(0%)";
          bindArrows();
          return;
        }

        // Deactivate the previously selected dot
        if (activeBodyDot) activeBodyDot.classList.remove("dot-selected");
        activeBodyDot = dot;
        dot.classList.add("dot-selected");

        // Update panel title + subtitle + banner link
        if (titleEl)   titleEl.textContent = meta.title;
        if (subEl)     subEl.textContent   = meta.sub;
        if (bannerBtn) bannerBtn.href       = "/collections/" + handle;

        // Rebuild carousel or show fallback
        if (!rebuildCarousel(prods)) {
          track.innerHTML = '<div class="ortho-slide ortho-no-products">'
            + '<p>No products found for this category. '
            + '<a href="/collections/orthopedic-braces-supports">Browse all →</a></p>'
            + '</div>';
          if (dotsWrap) dotsWrap.innerHTML =
            '<button type="button" class="ortho-dot active" data-slide="0"></button>';
          current = 0;
          track.style.transform = "translateX(0%)";
        }
      });
    });

    // ── Initial arrow bind ───────────────────────────────────────────────
    bindArrows();

    // ── Auto-select Neck as default (after data loads) ───────────────────
    catDataReady.then(function() {
      document.querySelector('.body-dot[data-handle="cervical"]')?.click();
    });
  })();
  </script>
</Layout>

