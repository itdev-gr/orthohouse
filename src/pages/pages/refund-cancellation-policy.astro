---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { pickLang, useTranslations, localizeHref } from "../../i18n/utils";

const lang = pickLang(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizeHref(p, lang);
const crumbs = [
  { label: t("nav.home"), href: lp("/") },
  { label: t("nav.pages"), href: null },
  { label: t("nav.refundPolicy"), href: null },
];
---

<Layout title="Refund & Cancellation Policy – OrthoHouse Cyprus">
  <Breadcrumb crumbs={crumbs} />
  <div class="rp-wrapper">

    <!-- Hero banner -->
    <div class="rp-hero">
      <div class="rp-hero-inner">
        <h1 class="rp-title">Refund &amp; Cancellation Policy</h1>
        <p class="rp-tagline">Your satisfaction is our priority</p>
      </div>
    </div>

    <!-- Main content -->
    <div class="rp-content">

      <!-- Returns -->
      <section class="rp-section">
        <div class="rp-section-text">
          <h2>Returns</h2>
          <p>
            Our Returns Policy lasts <strong>15 days</strong>. If 15 days have passed since your
            purchase, unfortunately we can't offer you a refund or exchange.
          </p>
        </div>
        <div class="rp-cards">
          <div class="rp-card">
            <div class="rp-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
            </div>
            <h3>15-Day Window</h3>
            <p>Returns accepted within 15 days of purchase</p>
          </div>
          <div class="rp-card">
            <div class="rp-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
              </svg>
            </div>
            <h3>Original Packaging</h3>
            <p>Item must be unused and in its original packaging</p>
          </div>
          <div class="rp-card">
            <div class="rp-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="22" height="22">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
              </svg>
            </div>
            <h3>Proof of Purchase</h3>
            <p>A receipt or proof of purchase is required</p>
          </div>
        </div>
      </section>

      <div class="rp-divider"></div>

      <!-- Refunds -->
      <section class="rp-section">
        <div class="rp-section-text">
          <h2>Refunds</h2>
          <p>
            Once your return is received and inspected, we will send you an email to notify you that
            we have received your returned item. We will also notify you of the approval or rejection
            of your refund.
          </p>
          <p style="margin-top: 0.75rem;">
            If you are approved, your refund will be processed and a credit will automatically be
            applied to your credit card or original method of payment within <strong>two weeks</strong>.
          </p>
        </div>
      </section>

      <div class="rp-divider"></div>

      <!-- Order Cancellation -->
      <section class="rp-section">
        <div class="rp-section-text">
          <h2>Order Cancellation</h2>
          <p>
            Once you have placed your order, we will send you an Order Confirmation email. You will
            be entitled to cancel your order within <strong>2 hours</strong> of placing it.
          </p>
          <p style="margin-top: 0.75rem;">
            If your order is cancelled within these 2 hours, you will be entitled to a
            <strong>full refund</strong>. Your refund will be processed and a credit will automatically
            be applied to your credit card or original method of payment within <strong>two weeks</strong>.
          </p>
        </div>
      </section>

      <div class="rp-divider"></div>

      <!-- Exchanges -->
      <section class="rp-section">
        <div class="rp-section-text">
          <h2>Exchanges</h2>
          <p>
            We only replace items if they are <strong>defective or damaged</strong>. If you need to
            exchange it for the same item, send us an email and post your item to:
          </p>
        </div>
        <div class="rp-address-box">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <div>
            <strong>H. OrthoHouse Ltd</strong><br />
            27B, March 25 Street<br />
            Engomi, 2408 Nicosia – Cyprus
          </div>
        </div>
        <a href="mailto:info@orthohouse.com.cy" class="rp-email-link">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
          info@orthohouse.com.cy
        </a>
      </section>

      <div class="rp-divider"></div>

      <!-- Shipping for returns -->
      <section class="rp-section">
        <div class="rp-section-text">
          <h2>Return Shipping</h2>
          <p>
            To return your product, mail it to the address below. You will be responsible for paying
            your own shipping costs for returning your item. <strong>Shipping costs are non-refundable.</strong>
            If you receive a refund, the cost of return shipping will be deducted from your refund.
          </p>
          <p style="margin-top: 0.75rem;">
            Depending on where you live, the time it may take for your exchanged product to reach you may vary.
          </p>
        </div>
        <div class="rp-address-box">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="18" height="18">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <div>
            <strong>H. OrthoHouse Ltd</strong><br />
            27B, March 25 Street<br />
            Engomi, 2408 Nicosia – Cyprus
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  /* ── Hero Banner ── */
  .rp-hero {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 100%);
    padding: 3.5rem 2rem;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }
  .rp-hero-inner {
    max-width: 860px;
    margin: 0 auto;
  }
  .rp-title {
    font-size: 2.6rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }
  .rp-tagline {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.7);
    font-style: italic;
    margin: 0;
  }

  /* ── Wrapper & content ── */
  .rp-wrapper {
    margin: -2rem 0 0 0;
  }
  .rp-content {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* ── Sections ── */
  .rp-section {
    padding: 2rem 0;
  }
  .rp-section-text h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.6rem 0;
  }
  .rp-section-text p {
    font-size: 1rem;
    color: #555;
    line-height: 1.75;
    margin: 0;
  }
  .rp-section-text strong {
    color: #1e3a5f;
    font-weight: 600;
  }

  /* ── Divider ── */
  .rp-divider {
    border: none;
    border-top: 1px solid #ebebeb;
    margin: 0;
  }

  /* ── Cards ── */
  .rp-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .rp-card {
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .rp-card:hover {
    box-shadow: 0 6px 24px rgba(30, 58, 95, 0.1);
    transform: translateY(-2px);
  }
  .rp-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #eef2f9;
    color: #1e3a5f;
    margin-bottom: 1rem;
  }
  .rp-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.4rem 0;
  }
  .rp-card p {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.65;
    margin: 0;
  }

  /* ── Address box ── */
  .rp-address-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    font-size: 0.9rem;
    color: #555;
    line-height: 1.7;
  }
  .rp-address-box svg {
    flex-shrink: 0;
    color: #1e3a5f;
    margin-top: 3px;
  }
  .rp-address-box strong {
    color: #1a1a1a;
    font-weight: 600;
  }

  /* ── Email link ── */
  .rp-email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: #1e3a5f;
    text-decoration: none;
    transition: color 0.15s;
  }
  .rp-email-link:hover {
    color: #2d5a8e;
    text-decoration: underline;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .rp-hero { padding: 2.5rem 1rem; }
    .rp-title { font-size: 1.9rem; }
    .rp-content { padding: 2rem 1rem 3rem; }
    .rp-cards { grid-template-columns: 1fr; }
  }
</style>
