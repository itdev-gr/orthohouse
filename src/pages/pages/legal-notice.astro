---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Legal Notice – OrthoHouse Cyprus">
  <div class="about-wrapper">

    <!-- Hero banner -->
    <div class="about-hero">
      <div class="about-hero-inner">
        <h1 class="about-title">Legal Notice</h1>
        <p class="about-tagline">Important legal information about OrthoHouse Cyprus</p>
      </div>
    </div>

    <!-- Main content -->
    <div class="about-content">

      <!-- Company Info -->
      <section class="about-section about-intro">
        <div class="about-section-text">
          <h2>Company Information</h2>
          <p>
            This website is owned and operated by <strong>O.H.OrthoHouse Ltd</strong>, a company registered
            in Cyprus. The details below constitute the official legal information for this business.
          </p>
        </div>
      </section>

      <div class="about-divider"></div>

      <!-- Registered Address -->
      <section class="about-section about-mission">
        <div class="about-section-text">
          <h2>Registered Address</h2>
          <p>
            O.H.Orthohouse Limited<br />
            27B, March 25 Street<br />
            Engomi, 2408<br />
            Nicosia, Cyprus
          </p>
        </div>
      </section>

      <div class="about-divider"></div>

      <!-- Contact cards -->
      <section class="about-values">
        <h2 class="about-values-title">Contact Details</h2>
        <div class="about-cards">
          <div class="about-card">
            <h3>Telephone</h3>
            <p><a href="tel:+35722660688">(+357) 22 66 06 88</a></p>
          </div>
          <div class="about-card">
            <h3>E-mail</h3>
            <p><a href="mailto:info@orthohouse.com.cy">info@orthohouse.com.cy</a></p>
          </div>
          <div class="about-card">
            <h3>Website</h3>
            <p><a href="https://www.orthohouse.com.cy" target="_blank" rel="noopener noreferrer">www.orthohouse.com.cy</a></p>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  /* ── Hero Banner ── */
  .about-hero {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 100%);
    padding: 3.5rem 2rem;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }
  .about-hero-inner {
    max-width: 860px;
    margin: 0 auto;
  }
  .about-title {
    font-size: 2.6rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }
  .about-tagline {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.7);
    font-style: italic;
    margin: 0;
  }

  /* ── Content wrapper ── */
  .about-wrapper {
    margin: -2rem 0 0 0;
  }
  .about-content {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* ── Sections ── */
  .about-section {
    padding: 2rem 0;
  }
  .about-section-text h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.6rem 0;
  }
  .about-section-text p {
    font-size: 1rem;
    color: #555;
    line-height: 1.75;
    margin: 0;
  }
  .about-section-text strong {
    color: #1e3a5f;
    font-weight: 600;
  }

  /* ── Divider ── */
  .about-divider {
    border: none;
    border-top: 1px solid #ebebeb;
    margin: 0;
  }

  /* ── Values / Cards ── */
  .about-values {
    padding-top: 2.5rem;
  }
  .about-values-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 1.75rem 0;
  }
  .about-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .about-card {
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .about-card:hover {
    box-shadow: 0 6px 24px rgba(30, 58, 95, 0.1);
    transform: translateY(-2px);
  }
  .about-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.5rem 0;
  }
  .about-card p {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.65;
    margin: 0;
  }
  .about-card a {
    color: #2563eb;
    text-decoration: none;
  }
  .about-card a:hover {
    text-decoration: underline;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .about-hero {
      padding: 2.5rem 1rem;
    }
    .about-title { font-size: 1.9rem; }
    .about-content { padding: 2rem 1rem 3rem; }
    .about-section {
      flex-direction: column;
      gap: 1rem;
    }
    .about-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
