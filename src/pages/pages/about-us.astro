---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { pickLang, useTranslations, localizeHref } from "../../i18n/utils";

const lang = pickLang(Astro.currentLocale, Astro.url);
const isEl = lang === "el";
const t = useTranslations(lang);
const lp = (p: string) => localizeHref(p, lang);
const crumbs = [
  { label: t("nav.home"), href: lp("/") },
  { label: t("nav.pages"), href: null },
  { label: t("about.title"), href: null },
];
---

<Layout title={isEl ? "Σχετικά με Εμάς – OrthoHouse Cyprus" : "About Us – OrthoHouse Cyprus"}>
  <Breadcrumb crumbs={crumbs} />
  <div class="about-wrapper">

    <!-- Hero banner -->
    <div class="about-hero">
      <div class="about-hero-inner">
<h1 class="about-title">{isEl ? "Σχετικά με την OrthoHouse" : "About OrthoHouse"}</h1>
        <p class="about-tagline">{isEl ? "Από την Υγεία στην Ευεξία" : "Doing Well to Wellbeing"}</p>
      </div>
    </div>

    <!-- Main content -->
    <div class="about-content">

      <!-- Founding story -->
      <section class="about-section about-intro">
        <div class="about-section-text">
          <h2>{isEl ? "Ιδρύθηκε το 2007" : "Founded in 2007"}</h2>
          <p>
            {isEl
              ? "Η OrthoHouse είναι αξιόπιστος, οικογενειακός πάροχος ορθωτικού, αποκαταστατικού και ιατρικού εξοπλισμού, με έδρα στην Έγκωμη κοντά στο Ιδιωτικό Νοσοκομείο Ιπποκράτειον, εξυπηρετώντας πελάτες σε όλη την Κύπρο και διεθνώς."
              : "OrthoHouse is a trusted, family-run provider of orthotic, rehabilitation, and medical equipment, based in Engomi near Hippocrateon Private Hospital and serving customers across Cyprus and worldwide."}
          </p>
        </div>
      </section>

      <!-- Divider -->
      <div class="about-divider"></div>

      <!-- Mission -->
      <section class="about-section about-mission">
        <div class="about-section-text">
          <h2>{isEl ? "Η Αποστολή μας" : "Our Mission"}</h2>
          <p>
            {isEl
              ? <>
                  Βοηθάμε τους ανθρώπους να κινούνται καλύτερα, να νιώθουν καλύτερα και να ζουν με μεγαλύτερη άνεση — με γνώμονα τη δέσμευσή μας <strong>Από την Υγεία στην Ευεξία</strong>. Κάθε προϊόν που διαθέτουμε και κάθε υπηρεσία που προσφέρουμε επιλέγεται με γνώμονα την ποιότητα ζωής των πελατών μας.
                </>
              : <>
                  We help people move better, feel better, and live with greater comfort — guided by our commitment to <strong>Doing Well to Wellbeing</strong>. Every product we carry and every service we offer is chosen with our customers' quality of life in mind.
                </>
            }
          </p>
        </div>
      </section>

      <!-- Divider -->
      <div class="about-divider"></div>

      <!-- Values cards -->
      <section class="about-values">
        <h2 class="about-values-title">{isEl ? "Τι Μας Ξεχωρίζει" : "What Sets Us Apart"}</h2>
        <div class="about-cards">
          <div class="about-card">
            <h3>{isEl ? "Οικογενειακή Επιχείρηση" : "Family-Run"}</h3>
            <p>{isEl
              ? "Προσωπική, στοργική προσέγγιση σε κάθε επαφή με τον πελάτη — γιατί φερόμαστε στους πελάτες μας σαν οικογένεια."
              : "A personal, caring approach to every customer interaction — because we treat our customers like family."}</p>
          </div>
          <div class="about-card">
            <h3>{isEl ? "Αξιόπιστη Ποιότητα" : "Trusted Quality"}</h3>
            <p>{isEl
              ? "Πάνω από 17 χρόνια εμπειρίας στην προμήθεια πιστοποιημένου ορθωτικού, αποκαταστατικού και ιατρικού εξοπλισμού."
              : "Over 17 years of experience supplying certified orthotic, rehabilitation, and medical equipment."}</p>
          </div>
          <div class="about-card">
            <h3>{isEl ? "Κύπρος & Παγκόσμια" : "Cyprus & Worldwide"}</h3>
            <p>{isEl
              ? "Με έδρα στην Έγκωμη, κοντά στο Ιδιωτικό Νοσοκομείο Ιπποκράτειον, εξυπηρετούμε πελάτες σε όλη την Κύπρο και διεθνώς."
              : "Headquartered in Engomi, near Hippocrateon Private Hospital, serving customers across Cyprus and internationally."}</p>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  /* ── Hero Banner ── */
  .about-hero {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 100%);
    padding: 3.5rem 2rem;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }
  .about-hero-inner {
    max-width: 860px;
    margin: 0 auto;
  }
.about-title {
    font-size: 2.6rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }
  .about-tagline {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.7);
    font-style: italic;
    margin: 0;
  }

  /* ── Content wrapper ── */
  .about-wrapper {
    margin: -2rem 0 0 0;
  }
  .about-content {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* ── Sections ── */
  .about-section {
    padding: 2rem 0;
  }
  .about-section-text h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.6rem 0;
  }
  .about-section-text p {
    font-size: 1rem;
    color: #555;
    line-height: 1.75;
    margin: 0;
  }
  .about-section-text strong {
    color: #1e3a5f;
    font-weight: 600;
  }

  /* ── Divider ── */
  .about-divider {
    border: none;
    border-top: 1px solid #ebebeb;
    margin: 0;
  }

  /* ── Values / Cards ── */
  .about-values {
    padding-top: 2.5rem;
  }
  .about-values-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 1.75rem 0;
  }
  .about-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .about-card {
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .about-card:hover {
    box-shadow: 0 6px 24px rgba(30, 58, 95, 0.1);
    transform: translateY(-2px);
  }
  .about-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.5rem 0;
  }
  .about-card p {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.65;
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .about-hero {
      padding: 2.5rem 1rem;
    }
    .about-title { font-size: 1.9rem; }
    .about-content { padding: 2rem 1rem 3rem; }
    .about-section {
      flex-direction: column;
      gap: 1rem;
    }
    .about-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
