---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Working Hours – OrthoHouse Cyprus">
  <div class="wh-wrapper">

    <!-- Hero banner -->
    <div class="wh-hero">
      <div class="wh-hero-inner">
<h1 class="wh-title">Working Hours</h1>
        <p class="wh-tagline">We're here when you need us</p>
      </div>
    </div>

    <!-- Main content -->
    <div class="wh-content">

      <!-- Location & Contact -->
      <section class="wh-section">
        <div class="wh-section-text">
          <h2>Location &amp; Contact</h2>
          <p class="wh-company-name">O.H. OrthoHouse Ltd</p>
          <p class="wh-address">27B 25th March Street, Engomi, 2408 Nicosia, Cyprus</p>
          <div class="wh-contact-row">
            <div class="wh-contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              <span><strong>Tel:</strong> <a href="tel:+35722660688">+357 22 66 06 88</a></span>
            </div>
            <div class="wh-contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
              <span><strong>Email:</strong> <a href="mailto:info@orthohouse.com.cy">info@orthohouse.com.cy</a></span>
            </div>
          </div>
        </div>
      </section>

      <div class="wh-divider"></div>

      <!-- Hours section -->
      <section class="wh-section">
        <div class="wh-section-text">
          <h2>Opening Hours</h2>
        </div>
        <div class="wh-cards">
          <div class="wh-card">
            <h3>Monday – Friday</h3>
            <p class="wh-time-display">09:00 – 19:00</p>
            <span class="badge badge-open">Open</span>
          </div>
          <div class="wh-card">
            <h3>Saturday</h3>
            <p class="wh-time-display">09:00 – 14:00</p>
            <span class="badge badge-open">Open</span>
          </div>
          <div class="wh-card wh-card-closed">
            <h3>Sunday</h3>
            <p class="wh-time-display">—</p>
            <span class="badge badge-closed">Closed</span>
          </div>
        </div>
      </section>

      <div class="wh-divider"></div>

      <!-- Emergency section -->
      <section class="wh-section">
        <div class="wh-section-text">
          <h2>Medical Emergency</h2>
          <p>
            For urgent medical equipment needs outside of working hours, contact us on our
            <strong>emergency line</strong> — available around the clock.
          </p>
        </div>
        <a href="tel:+35799774309" class="wh-emergency-number">+357 99 77 43 09</a>
      </section>

    </div>
  </div>
</Layout>

<style>
  /* ── Hero Banner ── */
  .wh-hero {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 100%);
    padding: 3.5rem 2rem;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }
  .wh-hero-inner {
    max-width: 860px;
    margin: 0 auto;
  }
.wh-title {
    font-size: 2.6rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }
  .wh-tagline {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.7);
    font-style: italic;
    margin: 0;
  }

  /* ── Wrapper & content ── */
  .wh-wrapper {
    margin: -2rem 0 0 0;
  }
  .wh-content {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* ── Sections ── */
  .wh-section {
    padding: 2rem 0;
  }
  .wh-section-text h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.6rem 0;
  }
  .wh-section-text p {
    font-size: 1rem;
    color: #555;
    line-height: 1.75;
    margin: 0;
  }
  .wh-section-text strong {
    color: #1e3a5f;
    font-weight: 600;
  }

  /* ── Divider ── */
  .wh-divider {
    border: none;
    border-top: 1px solid #ebebeb;
    margin: 0;
  }

  /* ── Location details ── */
  .wh-company-name {
    font-size: 1rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 0.25rem 0 !important;
  }
  .wh-address {
    font-size: 0.9rem;
    color: #666;
    margin: 0 0 1.1rem 0 !important;
    line-height: 1.5;
  }
  .wh-contact-row {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .wh-contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: #555;
  }
  .wh-contact-item svg {
    flex-shrink: 0;
    color: #1e3a5f;
  }
  .wh-contact-item a {
    color: #1e3a5f;
    text-decoration: none;
    font-weight: 500;
  }
  .wh-contact-item a:hover { text-decoration: underline; }

  /* ── Hours cards ── */
  .wh-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .wh-card {
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .wh-card:hover {
    box-shadow: 0 6px 24px rgba(30, 58, 95, 0.1);
    transform: translateY(-2px);
  }
  .wh-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.4rem 0;
  }
  .wh-card-closed h3 {
    color: #aaa;
  }
  .wh-time-display {
    font-size: 1.05rem;
    color: #444;
    font-variant-numeric: tabular-nums;
    margin: 0 0 0.85rem 0;
  }
  .wh-card-closed .wh-time-display {
    color: #bbb;
  }

  /* ── Badges ── */
  .badge {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .badge-open {
    background: #dcfce7;
    color: #15803d;
  }
  .badge-closed {
    background: #fee2e2;
    color: #b91c1c;
  }

  /* ── Emergency ── */
  .wh-emergency-number {
    display: inline-block;
    margin-top: 1rem;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1e3a5f;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s;
  }
  .wh-emergency-number:hover {
    color: #7f1d1d;
    text-decoration: underline;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .wh-hero {
      padding: 2.5rem 1rem;
    }
    .wh-title { font-size: 1.9rem; }
    .wh-content { padding: 2rem 1rem 3rem; }
    .wh-cards { grid-template-columns: 1fr; }
    .wh-emergency-number { font-size: 1.3rem; }
  }
</style>
