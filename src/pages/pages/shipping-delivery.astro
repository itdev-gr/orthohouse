---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { pickLang, useTranslations, localizeHref } from "../../i18n/utils";

const lang = pickLang(Astro.currentLocale, Astro.url);
const isEl = lang === "el";
const t = useTranslations(lang);
const lp = (p: string) => localizeHref(p, lang);
const crumbs = [
  { label: t("nav.home"), href: lp("/") },
  { label: t("nav.pages"), href: null },
  { label: t("shippingDelivery.title"), href: null },
];
---

<Layout title={isEl ? "Αποστολή & Παράδοση – OrthoHouse Cyprus" : "Shipping & Delivery – OrthoHouse Cyprus"}>
  <Breadcrumb crumbs={crumbs} />
  <div class="sd-wrapper">

    <!-- Hero banner -->
    <div class="sd-hero">
      <div class="sd-hero-inner">
<h1 class="sd-title">{isEl ? "Αποστολή & Παράδοση" : "Shipping & Delivery"}</h1>
        <p class="sd-tagline">{isEl ? "Γρήγορη, αξιόπιστη παράδοση σε Κύπρο και Ευρώπη" : "Fast, reliable delivery across Cyprus and Europe"}</p>
      </div>
    </div>

    <!-- Main content -->
    <div class="sd-content">

      <!-- Cyprus section -->
      <section class="sd-section">
        <div class="sd-section-text">
          <h2>{isEl ? "Κύπρος" : "Cyprus"}</h2>
          <p>
            {isEl
              ? <>Αποστέλλουμε τα προϊόντα μας μέσω <strong>courier ACS</strong> σε όλες τις πόλεις της Κύπρου. Οι παραδόσεις πραγματοποιούνται στις διευθύνσεις των πελατών, εκτός από περιορισμένες περιοχές που ορίζει η ACS.</>
              : <>We ship our products by <strong>ACS courier</strong> to all cities in Cyprus. Deliveries are made to homes except for limited service areas defined by ACS.</>
            }
          </p>
        </div>
        <div class="sd-cards">
          <div class="sd-card">
            <div class="sd-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
              </svg>
            </div>
            <h3>{isEl ? "Χρόνος Παράδοσης" : "Delivery Time"}</h3>
            <p>{isEl
              ? <>Εντός <strong>3 εργάσιμων ημερών</strong> από την υποβολή της παραγγελίας</>
              : <>Within <strong>3 working days</strong> of placing your order</>
            }</p>
          </div>
          <div class="sd-card">
            <div class="sd-card-icon sd-card-icon--green">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <h3>{isEl ? "Δωρεάν Αποστολή" : "Free Shipping"}</h3>
            <p>{isEl
              ? <>Η αποστολή εντός Κύπρου είναι <strong>δωρεάν</strong> για όλες τις παραγγελίες</>
              : <>Shipping in Cyprus is <strong>free of charge</strong> for all orders</>
            }</p>
          </div>
          <div class="sd-card">
            <div class="sd-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </div>
            <h3>{isEl ? "Courier ACS" : "ACS Courier"}</h3>
            <p>{isEl ? "Παράδοση στο σπίτι σας σε όλες τις πόλεις της Κύπρου" : "Delivered to your home across all cities in Cyprus"}</p>
          </div>
        </div>
      </section>

      <div class="sd-divider"></div>

      <!-- International section -->
      <section class="sd-section">
        <div class="sd-section-text">
          <h2>{isEl ? "Διεθνώς" : "International"}</h2>
          <p>
            {isEl
              ? <>Παρέχουμε παράδοση μέσω της <strong>Ταχυδρομικής Υπηρεσίας</strong> σε ενιαία χρέωση <strong>€15 ανά παραγγελία</strong> στις παρακάτω χώρες:</>
              : <>We currently provide delivery through the <strong>Postal Service</strong> at a flat rate of <strong>€15 per order</strong> to the following countries:</>
            }
          </p>
        </div>
        <div class="sd-countries">
          {isEl
            ? "Ανδόρα, Αυστρία, Βέλγιο, Βουλγαρία, Κροατία, Τσεχία, Δανία, Εσθονία, Φινλανδία, Γαλλία, Γερμανία, Ελλάδα, Ουγγαρία, Ισλανδία, Ιρλανδία, Ιταλία, Λετονία, Λιχτενστάιν, Λιθουανία, Λουξεμβούργο, Μάλτα, Μονακό, Ολλανδία, Νορβηγία, Πολωνία, Πορτογαλία, Ρουμανία, Άγιος Μαρίνος, Σλοβακία, Σλοβενία, Ισπανία, Σουηδία, Ελβετία, Ηνωμένο Βασίλειο, Βατικανό."
            : "Andorra, Austria, Belgium, Bulgaria, Croatia, Czech Republic, Denmark, Estonia, Finland, France, Germany, Greece, Hungary, Iceland, Ireland, Italy, Latvia, Liechtenstein, Lithuania, Luxembourg, Malta, Monaco, Netherlands, Norway, Poland, Portugal, Romania, San Marino, Slovakia, Slovenia, Spain, Sweden, Switzerland, UK, Vatican."
          }
        </div>
      </section>

      <div class="sd-divider"></div>

      <!-- More information section -->
      <section class="sd-section">
        <div class="sd-section-text">
          <h2>{isEl ? "Περισσότερες Πληροφορίες" : "More Information"}</h2>
          <p>{isEl
            ? <>Τα Κέντρα Διανομής μας δεν αποστέλλουν τα <strong>σαββατοκύριακα</strong> (Σάββατο και Κυριακή).</>
            : <>Our Distribution Centres do not dispatch over <strong>weekends</strong> (Saturday and Sunday).</>
          }</p>
        </div>
        <ul class="sd-info-list">
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <span>{isEl
              ? "Παρόλο που χρησιμοποιούμε όλα τα εύλογα μέσα για να διασφαλίσουμε την έγκαιρη παράδοση, δεν μπορούμε να αναλάβουμε ευθύνη για καθυστερήσεις λόγω συνθηκών εκτός ελέγχου μας. Θα κάνουμε το καλύτερο δυνατό για να σας ενημερώσουμε για κάθε απρόσμενη καθυστέρηση."
              : "Although we use all reasonable means to ensure timely delivery, we cannot accept responsibility for late deliveries due to circumstances outside of our control. We will do our best to inform you of any unexpected delay."
            }</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <span>{isEl
              ? "Ενδέχεται να υπάρξουν καθυστερήσεις ανάλογα με τη χώρα προορισμού — αυτό δεν ελέγχεται από εμάς. Σε περίπτωση καθυστέρησης παρακαλούμε επικοινωνήστε με το τοπικό σας ταχυδρομείο και δώστε τον αριθμό παρακολούθησης."
              : "Some delays may occur depending on the destination country and this is not possible to be controlled by us. In case of delay please contact your local post office and provide them with your tracking number."
            }</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <span>{isEl
              ? "Αν δεν είστε στο σπίτι όταν φτάσει το δέμα σας, ο μεταφορέας θα αφήσει σημείωμα με οδηγίες για το πού βρίσκεται — είτε αφημένο σε ασφαλές μέρος ή με λεπτομέρειες για παραλαβή ή νέα παράδοση."
              : "If you are not in when your parcel arrives, the carrier will leave a card telling you where it is — either left in a safe place or with details on how to pick up your order or rearrange delivery."
            }</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <span>{isEl
              ? "Σε επίσημες αργίες της χώρας σας δεν γίνονται παραδόσεις. Αναμένετε την παραγγελία σας την επόμενη εργάσιμη ημέρα."
              : "On any public holiday dates in your country, deliveries will not be made. Please expect your order to arrive the next business day."
            }</span>
          </li>
          <li>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
            <span>{isEl
              ? <>Παρακαλώ σημειώστε ότι οι πελάτες είναι <strong>υπεύθυνοι για την καταβολή τυχόν τοπικών τελωνειακών δασμών</strong>.</>
              : <>Please be aware that customers are <strong>responsible for payment of any local customs duties</strong>.</>
            }</span>
          </li>
        </ul>
      </section>

      <div class="sd-divider"></div>

      <!-- Contact section -->
      <section class="sd-section">
        <div class="sd-section-text">
          <h2>{isEl ? "Περαιτέρω Πληροφορίες" : "Further Enquiries"}</h2>
          <p>
            {isEl
              ? "Αν θέλετε περαιτέρω διευκρινίσεις για την αποστολή, επικοινωνήστε μαζί μας:"
              : "If you would like to further inquire about our shipping information, please contact us:"
            }
          </p>
        </div>
        <a href="mailto:info@orthohouse.com.cy" class="sd-email-link">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
          info@orthohouse.com.cy
        </a>
      </section>

    </div>
  </div>
</Layout>

<style>
  /* ── Hero Banner ── */
  .sd-hero {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 100%);
    padding: 3.5rem 2rem;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }
  .sd-hero-inner {
    max-width: 860px;
    margin: 0 auto;
  }
.sd-title {
    font-size: 2.6rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
  }
  .sd-tagline {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.7);
    font-style: italic;
    margin: 0;
  }

  /* ── Wrapper & content ── */
  .sd-wrapper {
    margin: -2rem 0 0 0;
  }
  .sd-content {
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }

  /* ── Sections ── */
  .sd-section {
    padding: 2rem 0;
  }
  .sd-section-text h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.6rem 0;
  }
  .sd-section-text p {
    font-size: 1rem;
    color: #555;
    line-height: 1.75;
    margin: 0;
  }
  .sd-section-text strong {
    color: #1e3a5f;
    font-weight: 600;
  }

  /* ── Divider ── */
  .sd-divider {
    border: none;
    border-top: 1px solid #ebebeb;
    margin: 0;
  }

  /* ── Cyprus cards ── */
  .sd-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .sd-card {
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .sd-card:hover {
    box-shadow: 0 6px 24px rgba(30, 58, 95, 0.1);
    transform: translateY(-2px);
  }
  .sd-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: #eef2f9;
    color: #1e3a5f;
    margin-bottom: 1rem;
  }
  .sd-card-icon--green {
    background: #dcfce7;
    color: #15803d;
  }
  .sd-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.4rem 0;
  }
  .sd-card p {
    font-size: 0.875rem;
    color: #666;
    line-height: 1.65;
    margin: 0;
  }
  .sd-card p strong {
    color: #1e3a5f;
    font-weight: 600;
  }

  /* ── Countries list ── */
  .sd-countries {
    margin-top: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    font-size: 0.9rem;
    color: #555;
    line-height: 1.8;
  }

  /* ── Info list ── */
  .sd-info-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .sd-info-list li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.9rem;
    color: #555;
    line-height: 1.65;
  }
  .sd-info-list li svg {
    flex-shrink: 0;
    color: #1e3a5f;
    margin-top: 2px;
  }
  .sd-info-list li strong {
    color: #1e3a5f;
    font-weight: 600;
  }

  /* ── Email link ── */
  .sd-email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: #1e3a5f;
    text-decoration: none;
    transition: color 0.15s;
  }
  .sd-email-link:hover {
    color: #2d5a8e;
    text-decoration: underline;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .sd-hero { padding: 2.5rem 1rem; }
    .sd-title { font-size: 1.9rem; }
    .sd-content { padding: 2rem 1rem 3rem; }
    .sd-cards { grid-template-columns: 1fr; }
  }
</style>
