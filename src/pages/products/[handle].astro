---
import Layout from "../../layouts/Layout.astro";
import {
  getAllProducts,
  getProductByHandle,
  getCollectionWithProducts,
  PRODUCT_QUERY,
} from "../../lib/shopify";
import { NAV_CATEGORIES, getCategoryLabel, getSubLabel } from "../../lib/menuConfig";
import { getProductExtendedData } from "../../lib/productData";
import { isQuotationOnly } from "../../lib/quotationCollections";
import RecentlyViewed from "../../components/RecentlyViewed.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { pickLang, useTranslations, localizeHref } from "../../i18n/utils";

export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((p: any) => ({ params: { handle: p.handle } }));
}

const lang = pickLang(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizeHref(p, lang);

const { handle } = Astro.params;
const product = await getProductByHandle(handle!);

if (!product) return Astro.redirect("/404");

// Strip Shopify-injected script tags
const cleanDescription =
  product.descriptionHtml?.replace(
    /<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi,
    ""
  ) ?? "";

const images: any[] = product.images.nodes;
const firstVariant = product.variants.nodes[0];
const hasMultipleImages = images.length > 1;
const hasMultipleVariants = product.variants.nodes.length > 1;

// Sale logic
const price = parseFloat(firstVariant?.price?.amount ?? "0");
const compareAt = parseFloat(firstVariant?.compareAtPrice?.amount ?? "0");
const isSale = compareAt > 0 && compareAt > price;
const currencyCode = firstVariant?.price?.currencyCode ?? "EUR";

// SKU & availability
const sku = firstVariant?.sku ?? "";
const isAvailable = firstVariant?.availableForSale ?? false;

// Related products
const collectionHandle = (product as any).collections?.nodes[0]?.handle ?? null;
const collectionTitle = (product as any).collections?.nodes[0]?.title ?? t("collection.relatedProducts");

// Quote-only collections (Sensory Rooms, Stair Lifts) — hide price, show CTA
const allCollectionHandles: string[] = ((product as any).collections?.nodes ?? []).map((n: any) => n.handle);
const quoteOnly = isQuotationOnly(allCollectionHandles);
const { products: relatedRaw } = collectionHandle
  ? await getCollectionWithProducts(collectionHandle)
  : { products: [] };
const relatedProducts = (relatedRaw as any[])
  .filter((p: any) => p.handle !== handle)
  .slice(0, 8);

// Extended product data
const extData = getProductExtendedData(handle!);

// Breadcrumb resolution — iterate ALL collection handles on the product
// and pick the best NAV match (prefer subcategory match — adds two levels).
function buildBreadcrumbs() {
  const crumbs: { label: string; href: string | null }[] = [
    { label: t("nav.home"), href: lp("/") },
    { label: lang === "el" ? "Προϊόντα" : "Products", href: lp("/#cat-section") },
  ];

  if (extData.breadcrumbs) {
    extData.breadcrumbs.forEach((b) => crumbs.push({ label: b.label, href: b.href }));
  } else {
    const productCollections: string[] = allCollectionHandles;

    let bestParent: typeof NAV_CATEGORIES[number] | null = null;
    let bestChild: typeof NAV_CATEGORIES[number]["children"][number] | null = null;

    for (const cat of NAV_CATEGORIES) {
      const child = cat.children.find((c) => productCollections.includes(c.handle));
      if (child) { bestParent = cat; bestChild = child; break; }
    }
    if (!bestParent) {
      bestParent = NAV_CATEGORIES.find((cat) => productCollections.includes(cat.handle)) ?? null;
    }

    if (bestParent) {
      crumbs.push({ label: getCategoryLabel(bestParent, lang), href: lp(`/collections/${bestParent.handle}`) });
      if (bestChild) {
        crumbs.push({ label: getSubLabel(bestChild, lang), href: lp(`/collections/${bestChild.handle}`) });
      }
    }
  }

  crumbs.push({ label: product.title, href: null });
  return crumbs;
}

const breadcrumbs = buildBreadcrumbs();

// Section 2 visibility
const hasSection2 =
  extData.brand ||
  extData.sizingGuideHtml ||
  extData.financialAssistancePdfUrl ||
  (extData.certificateLogos && extData.certificateLogos.length > 0) ||
  extData.woltDeliveryPdfUrl;

// Section 3 tabs
const tabs: { id: string; label: string }[] = [];
if (cleanDescription) tabs.push({ id: "description", label: lang === "el" ? "Περιγραφή" : "Description" });
if (extData.specifications && extData.specifications.length > 0)
  tabs.push({ id: "specifications", label: lang === "el" ? "Προδιαγραφές" : "Specifications" });
if (extData.infoIcons && extData.infoIcons.length > 0)
  tabs.push({ id: "features", label: lang === "el" ? "Χαρακτηριστικά" : "Features" });
if (extData.documents && extData.documents.length > 0)
  tabs.push({ id: "downloads", label: lang === "el" ? "Έγγραφα" : "Downloads" });
if (extData.videoUrl) tabs.push({ id: "video", label: lang === "el" ? "Βίντεο" : "Video" });
if (extData.faqs && extData.faqs.length > 0)
  tabs.push({ id: "faqs", label: lang === "el" ? "Συχνές Ερωτήσεις" : "FAQs" });
if (extData.additionalContent && extData.additionalContent.length > 0)
  tabs.push({ id: "more-info", label: lang === "el" ? "Περισσότερες Πληροφορίες" : "More Info" });

const hasSection3 = tabs.length > 0;
---

<Layout
  title={product.title}
  swrData={{
    query: PRODUCT_QUERY,
    variables: { handle },
    data: product,
    extract: "product",
  }}
>
  <!-- ══════════════ BREADCRUMBS ══════════════ -->
  <Breadcrumb crumbs={breadcrumbs} />

  <!-- ══════════════ SECTION 1: Product Top ══════════════ -->
  <div class="product-top" id="swr-target" data-swr-type="detail">
    <!-- Left: Image area -->
    <div class="image-area">
      <div class="main-image-col">
        {isSale && <span class="sale-badge">{lang === "el" ? "Προσφορά" : "Sale"}</span>}
        <button
          type="button"
          class="main-image-trigger"
          id="main-image-trigger"
          aria-label={lang === "el" ? "Μεγέθυνση εικόνας" : "Zoom image"}
        >
          <img
            id="main-image"
            src={images[0]?.url}
            alt={images[0]?.altText || product.title}
            class="main-image"
          />
          <span class="zoom-hint" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" width="22" height="22">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m-3-3h6"/>
            </svg>
          </span>
        </button>
      </div>

      {hasMultipleImages && (
        <div class="thumb-row">
          <button type="button" class="thumb-arrow thumb-arrow-left" id="thumb-left" aria-label={lang === "el" ? "Κύλιση αριστερά" : "Scroll left"}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <div class="thumb-track-wrap">
            <div class="thumb-track" id="thumb-track">
              {images.map((img: any, i: number) => (
                <button
                  type="button"
                  class={"thumb-btn" + (i === 0 ? " active" : "")}
                  data-src={img.url}
                  data-alt={img.altText || product.title}
                  aria-label={`${lang === "el" ? "Προβολή εικόνας" : "View image"} ${i + 1}`}
                >
                  <img src={img.url} alt={img.altText || product.title} />
                </button>
              ))}
            </div>
          </div>
          <button type="button" class="thumb-arrow thumb-arrow-right" id="thumb-right" aria-label={lang === "el" ? "Κύλιση δεξιά" : "Scroll right"}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      )}
    </div>

    <!-- Right: Product details -->
    <div class="details">
      <h1 class="product-title">{product.title}</h1>

      {sku && (
        <p class="product-sku">{t("product.productCode")} <span>{sku}</span></p>
      )}

      <div class={"availability-badge" + (isAvailable ? " in-stock" : " out-of-stock")}>
        {isAvailable ? (
          <>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="14" height="14">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            {lang === "el" ? "Διαθέσιμο" : "In Stock"}
          </>
        ) : (
          <>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="14" height="14">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
            {lang === "el" ? "Εξαντλημένο" : "Out of Stock"}
          </>
        )}
      </div>

      <!-- Price (or quote CTA for sensory-rooms / stair-lifts) -->
      <div class="price-block">
        {quoteOnly ? (
          <p class="price-quote">{t("product.contactForQuote")}</p>
        ) : isSale ? (
          <>
            <span class="price-compare">{currencyCode} {compareAt.toFixed(2)}</span>
            <span class="price-sale" id="variant-price">{currencyCode} {price.toFixed(2)}</span>
          </>
        ) : (
          <span class="price-regular" id="variant-price">
            {currencyCode} {price.toFixed(2)}
          </span>
        )}
      </div>

      <!-- Short Description (3 lines max, "Read More" scrolls to Section 3) -->
      {cleanDescription && (
        <div class="short-desc-wrap">
          <p class="short-desc" id="short-desc">{product.description}</p>
          {hasSection3 && (
            <button type="button" class="read-more-btn" id="read-more-top">
              {lang === "el" ? "Διαβάστε περισσότερα" : "Read more"}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="13" height="13">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
          )}
        </div>
      )}

      <!-- Variant selector -->
      {hasMultipleVariants && (
        <div class="variant-selector">
          <label class="variant-label" for="variant-select">{lang === "el" ? "Μέγεθος" : "Size"}</label>
          <div class="variant-select-wrap">
            <select id="variant-select" class="variant-select">
              {product.variants.nodes.map((v: any) => (
                <option
                  value={v.id}
                  data-price={v.price.amount}
                  data-compare={v.compareAtPrice?.amount ?? "0"}
                  data-currency={v.price.currencyCode}
                  data-available={v.availableForSale ? "true" : "false"}
                  disabled={!v.availableForSale}
                >
                  {v.title}{!v.availableForSale ? (lang === "el" ? " (Εξαντλημένο)" : " (Sold Out)") : ""}
                </option>
              ))}
            </select>
            <svg class="variant-select-chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </div>
        </div>
      )}

      <!-- Quantity + Add to Cart -->
      <div class="buy-row">
        <div class="qty-selector">
          <button type="button" class="qty-btn" id="qty-minus" aria-label={lang === "el" ? "Μείωση ποσότητας" : "Decrease quantity"}>&minus;</button>
          <span class="qty-display" id="qty-display">1</span>
          <button type="button" class="qty-btn" id="qty-plus" aria-label={lang === "el" ? "Αύξηση ποσότητας" : "Increase quantity"}>+</button>
        </div>

        {quoteOnly ? (
          <a class="add-to-cart-btn quote-btn" href={lp("/pages/find-us")}>
            {t("product.requestQuote")}
          </a>
        ) : (
          <button
            type="button"
            class="add-to-cart-btn"
            id="add-to-cart"
            data-variant-id={firstVariant?.id}
            disabled={!isAvailable}
          >
            {isAvailable ? (lang === "el" ? "Προσθήκη στο Καλάθι" : "Add to Cart") : (lang === "el" ? "Εξαντλημένο" : "Sold Out")}
          </button>
        )}
      </div>
    </div>
  </div>

  <!-- ══════════════ SECTION 2: Info & Badges ══════════════ -->
  {hasSection2 && (
    <section class="section-2">
      <div class="badges-grid">
        {extData.sizingGuideHtml && (
          <button type="button" class="badge-card badge-interactive" id="open-sizing-guide">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="28" height="28">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 6h9M7.5 12h4.5m-4.5 6h9M3.75 3h16.5a.75.75 0 0 1 .75.75v16.5a.75.75 0 0 1-.75.75H3.75a.75.75 0 0 1-.75-.75V3.75A.75.75 0 0 1 3.75 3Z" />
            </svg>
            <span>{lang === "el" ? "Βρείτε το Μέγεθός σας" : "Find Your Size"}</span>
          </button>
        )}

        {extData.financialAssistancePdfUrl && (
          <a href={extData.financialAssistancePdfUrl} target="_blank" rel="noopener noreferrer" class="badge-card">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="28" height="28">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
            <span>{lang === "el" ? "Επιλέξιμο για Οικονομική Βοήθεια" : "Eligible to Financial Assistance"}</span>
          </a>
        )}

        {extData.brand && (
          <div class="badge-card badge-brand">
            {extData.brand.logoUrl && (
              <img src={extData.brand.logoUrl} alt={extData.brand.name} class="brand-logo" />
            )}
            <span>{extData.brand.name}</span>
          </div>
        )}

        {extData.certificateLogos?.map((cert) => (
          <a
            href={cert.pdfUrl || "#"}
            target={cert.pdfUrl ? "_blank" : undefined}
            rel={cert.pdfUrl ? "noopener noreferrer" : undefined}
            class="badge-card"
          >
            <img src={cert.imageUrl} alt={cert.label} class="cert-logo" />
            <span>{cert.label}</span>
          </a>
        ))}

        {extData.woltDeliveryPdfUrl && (
          <a href={extData.woltDeliveryPdfUrl} target="_blank" rel="noopener noreferrer" class="badge-card">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="28" height="28">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0H6.75m11.25 0h2.625c.621 0 1.125-.504 1.125-1.125v-4.875c0-.621-.504-1.125-1.125-1.125h-3.375L14.25 5.437a1.125 1.125 0 0 0-.95-.524H6.75a1.125 1.125 0 0 0-1.125 1.125v12.087" />
            </svg>
            <span>{lang === "el" ? "Παράδοση Wolt" : "Wolt Delivery"}</span>
          </a>
        )}
      </div>
    </section>
  )}

  <!-- Sizing Guide Modal -->
  {extData.sizingGuideHtml && (
    <dialog class="sizing-modal" id="sizing-modal">
      <div class="sizing-modal-content">
        <div class="sizing-modal-header">
          <h2>{lang === "el" ? "Οδηγός Μεγεθών" : "Sizing Guide"}</h2>
          <button type="button" class="sizing-modal-close" id="close-sizing-guide" aria-label={lang === "el" ? "Κλείσιμο" : "Close"}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="20" height="20">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="sizing-modal-body" set:html={extData.sizingGuideHtml} />
      </div>
    </dialog>
  )}

  <!-- ══════════════ SECTION 3: Detailed Content Tabs ══════════════ -->
  {hasSection3 && (
    <section class="section-3" id="section-3">
      <!-- Tab bar -->
      <div class="tab-bar" id="tab-bar">
        {tabs.map((tab, i) => (
          <button
            type="button"
            class={"tab-btn" + (i === 0 ? " active" : "")}
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      <div class="tab-panels">
        <!-- Description -->
        {cleanDescription && (
          <div class={"tab-panel" + (tabs[0]?.id === "description" ? " active" : "")} id="tab-panel-description">
            <div class="desc-content" id="desc-content">
              <div class="desc-clip" id="desc-clip-s3">
                <div class="description" id="desc-body" set:html={cleanDescription} />
              </div>
              <button type="button" class="desc-toggle" id="desc-toggle-s3" aria-expanded="false" style="display:none;">
                {lang === "el" ? "Διαβάστε περισσότερα" : "Read more"}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="13" height="13" class="desc-toggle-icon">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </button>
            </div>
          </div>
        )}

        <!-- Specifications -->
        {extData.specifications && extData.specifications.length > 0 && (
          <div class={"tab-panel" + (tabs[0]?.id === "specifications" ? " active" : "")} id="tab-panel-specifications">
            <table class="specs-table">
              <thead>
                <tr>
                  <th>{lang === "el" ? "Προδιαγραφή" : "Specification"}</th>
                  <th>{lang === "el" ? "Λεπτομέρειες" : "Details"}</th>
                </tr>
              </thead>
              <tbody>
                {extData.specifications.map((spec, i) => (
                  <tr class={i % 2 === 1 ? "alt" : ""}>
                    <td class="spec-label">{spec.label}</td>
                    <td class="spec-value">{spec.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <!-- Features (Informational Icons) -->
        {extData.infoIcons && extData.infoIcons.length > 0 && (
          <div class={"tab-panel" + (tabs[0]?.id === "features" ? " active" : "")} id="tab-panel-features">
            <div class="info-icons-grid">
              {extData.infoIcons.slice(0, 12).map((icon) => (
                <div class="info-icon-item">
                  <img src={icon.iconUrl} alt={icon.label} class="info-icon-img" />
                  <span class="info-icon-label">{icon.label}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Downloads -->
        {extData.documents && extData.documents.length > 0 && (
          <div class={"tab-panel" + (tabs[0]?.id === "downloads" ? " active" : "")} id="tab-panel-downloads">
            <div class="downloads-grid">
              {extData.documents.slice(0, 6).map((doc) => (
                <a href={doc.url} target="_blank" rel="noopener noreferrer" class="download-card">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="32" height="32" class="download-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                  </svg>
                  <div class="download-info">
                    <span class="download-title">{doc.title}</span>
                    <span class="download-type">{doc.type.toUpperCase()}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Video -->
        {extData.videoUrl && (
          <div class={"tab-panel" + (tabs[0]?.id === "video" ? " active" : "")} id="tab-panel-video">
            <div class="video-wrap">
              <iframe
                src={extData.videoUrl}
                title={lang === "el" ? "Βίντεο προϊόντος" : "Product video"}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              />
            </div>
          </div>
        )}

        <!-- FAQs -->
        {extData.faqs && extData.faqs.length > 0 && (
          <div class={"tab-panel" + (tabs[0]?.id === "faqs" ? " active" : "")} id="tab-panel-faqs">
            <div class="faqs-list">
              {extData.faqs.map((faq) => (
                <details class="faq-item">
                  <summary class="faq-question">{faq.question}</summary>
                  <p class="faq-answer">{faq.answer}</p>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- Additional Content / More Info -->
        {extData.additionalContent && extData.additionalContent.length > 0 && (
          <div class={"tab-panel" + (tabs[0]?.id === "more-info" ? " active" : "")} id="tab-panel-more-info">
            {extData.additionalContent.map((block, i) => (
              <div class={"content-block" + (block.imageUrl ? (block.imagePosition === "left" ? " img-left" : " img-right") : "")}>
                {block.imageUrl && (
                  <div class="content-block-img">
                    <img src={block.imageUrl} alt={block.heading || ""} />
                  </div>
                )}
                <div class="content-block-text">
                  {block.heading && <h3>{block.heading}</h3>}
                  <div set:html={block.html} />
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ══════════════ RELATED PRODUCTS ══════════════ -->
  {relatedProducts.length > 0 && (
    <section class="related">
      <div class="related-header">
        <h2 class="related-title">{t("product.similarProducts")}</h2>
        <div class="related-arrows">
          <button type="button" class="rel-arrow" id="rel-prev" aria-label={lang === "el" ? "Προηγούμενα προϊόντα" : "Previous products"}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button type="button" class="rel-arrow" id="rel-next" aria-label={lang === "el" ? "Επόμενα προϊόντα" : "Next products"}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="16" height="16">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      </div>
      <div class="related-track-wrap">
        <div class="related-track" id="related-track">
          {relatedProducts.map((p: any) => (
            <a class="rel-card" href={lp(`/products/${p.handle}`)}>
              <div class="rel-card-img-wrap">
                {p.featuredImage ? (
                  <img
                    src={p.featuredImage.url}
                    alt={p.featuredImage.altText || p.title}
                  />
                ) : (
                  <div class="rel-card-img-placeholder" />
                )}
              </div>
              <div class="rel-info">
                <h3 class="rel-card-title">{p.title}</h3>
                <span class={"stock-pill " + (p.availableForSale ? "in" : "out")}>
                  {p.availableForSale ? t("card.inStock") : t("card.outOfStock")}
                </span>
                <p class="rel-price">
                  {p.priceRange.minVariantPrice.currencyCode}{" "}
                  {parseFloat(p.priceRange.minVariantPrice.amount).toFixed(2)}
                </p>
                <div class="rel-card-cta">
                  {t("collection.viewProduct")}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="13" height="13">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Recently Viewed Products (per Remarks §11) -->
  <div
    id="product-meta"
    hidden
    data-handle={product.handle}
    data-title={product.title}
    data-image={images[0]?.url ?? ""}
    data-price={String(price)}
    data-currency={currencyCode}
  ></div>
  <RecentlyViewed />

  <!-- Image Lightbox (per Remarks §15) -->
  <dialog id="image-lightbox" class="image-lightbox" aria-label={lang === "el" ? "Μεγέθυνση εικόνας" : "Image zoom"}>
    <button type="button" class="lightbox-close" id="lightbox-close" aria-label={lang === "el" ? "Κλείσιμο" : "Close"}>×</button>
    <img id="lightbox-img" src="" alt="" />
    <div class="lightbox-nav">
      <button type="button" id="lightbox-prev" class="lightbox-arrow" aria-label={lang === "el" ? "Προηγούμενο" : "Previous"}>‹</button>
      <button type="button" id="lightbox-next" class="lightbox-arrow" aria-label={lang === "el" ? "Επόμενο" : "Next"}>›</button>
    </div>
  </dialog>

  <!-- Add-to-Cart confirmation modal (per Remarks §16 / §17) -->
  {!quoteOnly && (
    <dialog id="add-confirm" class="add-confirm" aria-label={t("cart.itemAdded")}>
      <div class="add-confirm__inner">
        <div class="add-confirm__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="32" height="32">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
        </div>
        <p class="add-confirm__title">{t("cart.itemAdded")}</p>
        <p class="add-confirm__product">{product.title}</p>
        <div class="add-confirm__actions">
          <button type="button" class="add-confirm__btn add-confirm__btn--ghost" id="add-confirm-continue">{t("cart.continueShopping")}</button>
          <a class="add-confirm__btn add-confirm__btn--primary" href={lp("/cart")}>{t("cart.viewCart")}</a>
        </div>
      </div>
    </dialog>
  )}
</Layout>

<style>
  /* Breadcrumb styles now live in src/components/Breadcrumb.astro */

  /* ══════════════ SECTION 1: Product Top ══════════════ */
  .product-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    max-width: 100%;
    overflow: hidden;
  }

  /* ── Image Area ── */
  .image-area {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    max-width: 100%;
  }
  .main-image-col {
    position: relative;
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }
  .main-image {
    width: 100%;
    max-height: 520px;
    object-fit: contain;
    display: block;
    padding: 1rem;
  }
