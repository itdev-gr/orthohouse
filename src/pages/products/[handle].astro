  }
  .quote-btn {
    text-align: center;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .stock-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.18rem 0.45rem;
    border-radius: 999px;
    margin-bottom: 0.35rem;
    align-self: flex-start;
  }
  .stock-pill.in  { background: #ecfdf5; color: #047857; }
  .stock-pill.out { background: #fef2f2; color: #b91c1c; }

  /* Image lightbox trigger (per Remarks §15) */
  .main-image-trigger {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    width: 100%;
  }
  .main-image-trigger:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
  .zoom-hint {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(15,23,42,.7);
    color: #fff;
    padding: 0.4rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .image-lightbox {
    border: none;
    background: rgba(15, 23, 42, 0.92);
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    inset: 0;
    margin: 0;
  }
  .image-lightbox::backdrop { background: rgba(15,23,42,.92); }
  .image-lightbox img {
    display: block;
    margin: auto;
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    cursor: zoom-out;
  }
  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.15);
    color: #fff;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }
  .lightbox-close:hover { background: rgba(255,255,255,.28); }
  .lightbox-nav {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 1rem;
    pointer-events: none;
  }
  .lightbox-arrow {
    pointer-events: auto;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.15);
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-arrow:hover { background: rgba(255,255,255,.28); }

  /* Add-to-Cart confirmation modal (per Remarks §16 / §17) */
  .add-confirm {
    border: none;
    border-radius: 14px;
    padding: 0;
    width: min(420px, calc(100% - 2rem));
    box-shadow: 0 18px 60px rgba(15, 23, 42, 0.28);
  }
  .add-confirm::backdrop { background: rgba(15,23,42,.55); }
  .add-confirm__inner { padding: 1.5rem 1.5rem 1.25rem; text-align: center; }
  .add-confirm__icon {
    width: 56px; height: 56px;
    margin: 0 auto 0.75rem;
    border-radius: 50%;
    background: #ecfdf5;
    color: #047857;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .add-confirm__title { font-weight: 700; font-size: 1.05rem; margin: 0 0 0.25rem; color: #1e3a5f; }
  .add-confirm__product { font-size: 0.9rem; color: #555; margin: 0 0 1.25rem; }
  .add-confirm__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .add-confirm__btn {
    appearance: none;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0.7rem 1rem;
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .add-confirm__btn--ghost {
    background: #fff;
    border-color: #d1d5db;
    color: #1e3a5f;
  }
  .add-confirm__btn--ghost:hover { background: #f3f4f6; }
  .add-confirm__btn--primary {
    background: #2563eb;
    color: #fff;
  }
  .add-confirm__btn--primary:hover { background: #1d4ed8; }

  /* Short description */
  .short-desc-wrap {
    border-top: 1px solid #f0f0f0;
    padding-top: 0.75rem;
  }
  .short-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #555;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    background: #fff;
    border: 1.5px solid #d1d5db;
    border-radius: 20px;
    padding: 0.35rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1e3a5f;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s, background 0.15s;
  }
  .read-more-btn:hover {
    border-color: #1e3a5f;
    background: #f0f4ff;
  }

  /* Variant selector */
  .variant-selector { display: flex; flex-direction: column; gap: 0.4rem; }
  .variant-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .variant-select-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .variant-select {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    padding: 0.6rem 2.5rem 0.6rem 0.85rem;
    font-size: 0.9rem;
    font-family: inherit;
    color: #1a1a1a;
    background: #fff;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .variant-select:hover { border-color: #1e3a5f; }
  .variant-select:focus {
    border-color: #1e3a5f;
    box-shadow: 0 0 0 3px rgba(30, 58, 95, 0.1);
  }
  .variant-select-chevron {
    position: absolute;
    right: 0.75rem;
    pointer-events: none;
    color: #666;
  }

  /* Buy row */
  .buy-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .qty-selector {
    display: flex;
    align-items: center;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  .qty-btn {
    width: 38px;
    height: 44px;
    font-size: 1.2rem;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    color: #333;
    transition: background 0.15s;
    font-family: inherit;
  }
  .qty-btn:hover { background: #f3f4f6; }
  .qty-display {
    min-width: 36px;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1a1a1a;
    border-left: 1.5px solid #d1d5db;
    border-right: 1.5px solid #d1d5db;
    padding: 0 0.5rem;
    line-height: 44px;
    display: block;
  }
  .add-to-cart-btn {
    flex: 1;
    min-width: 140px;
    padding: 0.75rem 1.5rem;
    background: #1e3a5f;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s;
    font-family: inherit;
    height: 44px;
  }
  .add-to-cart-btn:hover:not(:disabled) { background: #2d5a8e; }
  .add-to-cart-btn:disabled { background: #9ca3af; cursor: not-allowed; }
  .add-to-cart-btn.loading { opacity: 0.7; pointer-events: none; }

  /* ══════════════ SECTION 2: Info & Badges ══════════════ */
  .section-2 {
    margin-top: 2rem;
    padding: 1.5rem;
    background: #f8fafc;
    border: 1px solid #e8edf3;
    border-radius: 12px;
  }
  .badges-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: stretch;
  }
  .badge-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #1e3a5f;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    cursor: pointer;
  }
  .badge-card:hover {
    border-color: #1e3a5f;
    box-shadow: 0 2px 8px rgba(30, 58, 95, 0.1);
  }
  .badge-interactive {
    border: none;
    font-family: inherit;
  }
  .badge-brand { cursor: default; }
  .badge-brand:hover { box-shadow: none; border-color: #e5e7eb; }
  .brand-logo {
    width: 40px;
    height: 28px;
    object-fit: contain;
  }
  .cert-logo {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  /* ── Sizing Guide Modal ── */
  .sizing-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    max-width: 600px;
    width: calc(100% - 2rem);
    max-height: 85vh;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
  }
  .sizing-modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }
  .sizing-modal-content {
    display: flex;
    flex-direction: column;
    max-height: 85vh;
  }
  .sizing-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e8edf3;
  }
  .sizing-modal-header h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }
  .sizing-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: #f3f4f6;
    border-radius: 8px;
    cursor: pointer;
    color: #555;
    transition: background 0.15s;
  }
  .sizing-modal-close:hover { background: #e5e7eb; }
  .sizing-modal-body {
    padding: 1.25rem;
    overflow-y: auto;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #555;
  }

  /* ══════════════ SECTION 3: Tabs ══════════════ */
  .section-3 {
    margin-top: 2.5rem;
    border-top: 1px solid #e8edf3;
    padding-top: 1.5rem;
  }

  /* Tab bar */
  .tab-bar {
    display: flex;
    gap: 0;
    border-bottom: 2px solid #e8edf3;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .tab-bar::-webkit-scrollbar { display: none; }
  .tab-btn {
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #888;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
    font-family: inherit;
  }
  .tab-btn:hover { color: #1e3a5f; }
  .tab-btn.active {
    color: #1e3a5f;
    border-bottom-color: #1e3a5f;
  }

  /* Tab panels */
  .tab-panels { padding-top: 1.5rem; }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ── Description tab ── */
  .desc-content { position: relative; }
  .desc-clip {
    position: relative;
    overflow: hidden;
    transition: max-height 0.45s ease;
  }
  .desc-clip::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4rem;
    background: linear-gradient(to bottom, transparent, #fff);
    pointer-events: none;
    transition: opacity 0.35s;
  }
  .desc-clip.expanded::after { opacity: 0; }
  .description {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #555;
  }
  .description :global(p) { margin-bottom: 0.5rem; }
  .description :global(a) { color: #2563eb; }
  .description :global(.desc-heading) {
    font-weight: 700;
    color: #1a1a1a;
    font-size: 0.875rem;
    margin-top: 0.85rem;
    margin-bottom: 0.2rem;
  }
  .description :global(.desc-line) { padding-left: 1rem; }
  .description :global(.desc-spacer) { height: 0.4rem; }
  .desc-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.75rem;
    background: #fff;
    border: 1.5px solid #d1d5db;
    border-radius: 20px;
    padding: 0.35rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #1e3a5f;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s, background 0.15s;
  }
  .desc-toggle:hover {
    border-color: #1e3a5f;
    background: #f0f4ff;
  }
  .desc-toggle-icon {
    transition: transform 0.35s;
    flex-shrink: 0;
  }

  /* ── Specifications table ── */
  .specs-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .specs-table th {
    background: #1e3a5f;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    text-align: left;
  }
  .specs-table td {
    padding: 0.65rem 1rem;
    font-size: 0.875rem;
    border-bottom: 1px solid #e8edf3;
    word-break: break-word;
  }
  .specs-table tr.alt td { background: #f8fafc; }
  .spec-label {
    font-weight: 600;
    color: #1e3a5f;
  }
  .spec-value { color: #555; }

  /* ── Info Icons grid ── */
  .info-icons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .info-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }
  .info-icon-img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }
  .info-icon-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: #555;
  }

  /* ── Downloads grid ── */
  .downloads-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .download-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .download-card:hover {
    border-color: #1e3a5f;
    box-shadow: 0 4px 12px rgba(30, 58, 95, 0.1);
    transform: translateY(-2px);
  }
  .download-icon { color: #dc2626; flex-shrink: 0; }
  .download-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .download-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a1a1a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .download-type {
    font-size: 0.72rem;
    font-weight: 600;
    color: #dc2626;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ── Video ── */
  .video-wrap {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #000;
  }
  .video-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* ── FAQs ── */
  .faqs-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .faq-item {
    border: 1px solid #e8edf3;
    border-radius: 8px;
    overflow: hidden;
  }
  .faq-question {
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1e3a5f;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 400;
    color: #888;
    flex-shrink: 0;
    margin-left: 0.5rem;
    transition: transform 0.2s;
  }
  .faq-item[open] .faq-question::after {
    content: '\2212';
  }
  .faq-item[open] .faq-question {
    border-bottom: 1px solid #e8edf3;
    background: #f8fafc;
  }
  .faq-answer {
    padding: 0.85rem 1rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #555;
    margin: 0;
  }

  /* ── Additional Content Blocks ── */
  .content-block {
    margin-bottom: 2rem;
  }
  .content-block.img-left,
  .content-block.img-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .content-block.img-left .content-block-img { order: -1; }
  .content-block-img img {
    width: 100%;
    border-radius: 8px;
    object-fit: cover;
  }
  .content-block-text h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.75rem 0;
  }
  .content-block-text :global(p) {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #555;
    margin-bottom: 0.5rem;
  }

  /* ══════════════ RELATED PRODUCTS ══════════════ */
  .related {
    margin-top: 3rem;
    border-top: 1px solid #f0f0f0;
    padding-top: 2rem;
  }
  .related-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .related-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }
  .related-arrows { display: flex; gap: 0.5rem; }
  .rel-arrow {
    width: 38px;
    height: 38px;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    background: #fff;
    color: #1e3a5f;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, border-color 0.15s;
  }
  .rel-arrow:hover { background: #f0f4ff; border-color: #1e3a5f; }
  .related-track-wrap { overflow: hidden; max-width: 100%; }
  .related-track {
    display: flex;
    gap: 1.25rem;
    transition: transform 0.35s ease;
  }
  .rel-card {
    flex: 0 0 220px;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid #e8edf3;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .rel-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(30, 58, 95, 0.12);
  }
  .rel-card-img-wrap {
    background: #f8fafc;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
  }
  .rel-card-img-wrap img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    padding: 0.75rem;
    display: block;
    transition: transform 0.3s;
  }
  .rel-card:hover .rel-card-img-wrap img { transform: scale(1.04); }
  .rel-card-img-placeholder { width: 100%; height: 180px; background: #e8edf3; }
  .rel-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem 1rem;
    border-top: 1px solid #f0f4f8;
  }
  .rel-card-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.4;
    margin: 0 0 0.35rem 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rel-price {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1e3a5f;
    margin: 0 0 0.75rem 0;
  }
  .rel-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e3a5f;
    transition: color 0.15s, gap 0.15s;
  }
  .rel-card:hover .rel-card-cta { color: #2d5a8e; gap: 0.5rem; }

  /* ══════════════ MOBILE ══════════════ */
  @media (max-width: 768px) {
    .product-top {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      overflow: visible;
    }

    .image-area,
    .main-image-col,
    .thumb-row,
    .details,
    .product-title,
    .buy-row,
    .variant-selector,
    .short-desc-wrap,
    .section-2,
    .section-3,
    .related {
      max-width: 100%;
      box-sizing: border-box;
    }

    .main-image-col { min-height: 260px; }

    .thumb-btn { width: 60px; height: 60px; }

    .buy-row { flex-direction: column; align-items: stretch; }
    .add-to-cart-btn { min-width: 0; width: 100%; }
    .qty-selector { justify-content: center; }

    .section-2 { padding: 1rem; }
    .badges-grid { gap: 0.5rem; }
    .badge-card { flex: 1 1 calc(50% - 0.5rem); min-width: 0; font-size: 0.78rem; padding: 0.6rem 0.75rem; }

    .sizing-modal {
      max-width: 100%;
      width: 100%;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
      margin: 0;
    }
    .sizing-modal-content { max-height: 100vh; }

    .tab-btn { padding: 0.65rem 1rem; font-size: 0.8rem; }

    .specs-table th,
    .specs-table td {
      padding: 0.5rem 0.65rem;
      font-size: 0.8rem;
    }

    .info-icons-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }

    .downloads-grid { grid-template-columns: 1fr; }

    .content-block.img-left,
    .content-block.img-right {
      grid-template-columns: 1fr;
    }
    .content-block.img-left .content-block-img { order: 0; }
  }
</style>

<script is:inline>
(function () {
  /* ── Description: detect ALL-CAPS headings and style them ── */
  (function () {
    var desc = document.querySelector(".description");
    if (!desc) return;
    var html = desc.innerHTML;
    html = html.replace(/<\/p>/gi, "\n").replace(/<p[^>]*>/gi, "");
    html = html.replace(/<br\s*\/?>/gi, "\n");
    var lines = html.split("\n");
    var out = "";
    lines.forEach(function (line) {
      var t = line.trim();
      if (!t || t === "&nbsp;") {
        out += '<div class="desc-spacer"></div>';
        return;
      }
      var isHeading = /[A-Z]/.test(t) && !/[a-z]/.test(t);
      out += isHeading
        ? '<div class="desc-heading">' + t + "</div>"
        : '<div class="desc-line">' + t + "</div>";
    });
    desc.innerHTML = out;
  })();

  /* ── Section 3 description Read More toggle ── */
  (function () {
    var clip = document.getElementById("desc-clip-s3");
    var toggle = document.getElementById("desc-toggle-s3");
    if (!clip || !toggle) return;

    var MAX_H = 280; // collapsed height in px

    function init() {
      if (clip.scrollHeight <= MAX_H + 4) {
        // Content fits — no need to clip
        toggle.style.display = "none";
        clip.style.overflow = "visible";
        return;
      }

      clip.style.maxHeight = MAX_H + "px";
      toggle.style.display = "inline-flex";

      var expanded = false;
      var labelNode = toggle.firstChild;
      var iconEl = toggle.querySelector(".desc-toggle-icon");

      toggle.addEventListener("click", function () {
        expanded = !expanded;
        if (expanded) {
          clip.style.maxHeight = clip.scrollHeight + "px";
          clip.classList.add("expanded");
        } else {
          clip.style.maxHeight = MAX_H + "px";
          clip.classList.remove("expanded");
        }
        if (labelNode && labelNode.nodeType === 3) {
          labelNode.textContent = expanded ? "Show less " : "Read more ";
        }
        if (iconEl) iconEl.style.transform = expanded ? "rotate(180deg)" : "rotate(0deg)";
        toggle.setAttribute("aria-expanded", String(expanded));
      });
    }

    if (document.readyState === "complete") {
      init();
    } else {
      window.addEventListener("load", init);
    }
  })();

  /* ── Section 1 "Read more" smooth scrolls to Section 3 ── */
  var readMoreTop = document.getElementById("read-more-top");
  if (readMoreTop) {
    readMoreTop.addEventListener("click", function () {
      var section3 = document.getElementById("section-3");
      if (section3) {
        section3.scrollIntoView({ behavior: "smooth", block: "start" });
        // Activate Description tab if exists
        var descTab = document.querySelector('[data-tab="description"]');
        if (descTab) descTab.click();
      }
    });
  }

  /* ── Horizontal thumbnail gallery ── */
  var mainImg = document.getElementById("main-image");
  var thumbTrack = document.getElementById("thumb-track");
  var thumbLeft = document.getElementById("thumb-left");
  var thumbRight = document.getElementById("thumb-right");
  var thumbOffset = 0;
  var THUMB_STEP = 80; // thumb width + gap

  if (thumbTrack && mainImg) {
    thumbTrack.addEventListener("click", function (e) {
      var btn = e.target.closest(".thumb-btn");
      if (!btn) return;
      thumbTrack.querySelectorAll(".thumb-btn").forEach(function (b) {
        b.classList.remove("active");
      });
      btn.classList.add("active");
      mainImg.src = btn.dataset.src;
      mainImg.alt = btn.dataset.alt;
    });
  }

  if (thumbLeft && thumbTrack) {
    thumbLeft.addEventListener("click", function () {
      thumbOffset = Math.max(0, thumbOffset - THUMB_STEP * 2);
      thumbTrack.style.transform = "translateX(-" + thumbOffset + "px)";
    });
  }
  if (thumbRight && thumbTrack) {
    thumbRight.addEventListener("click", function () {
      var wrap = thumbTrack.parentElement;
      var maxScroll = Math.max(0, thumbTrack.scrollWidth - wrap.clientWidth);
      thumbOffset = Math.min(maxScroll, thumbOffset + THUMB_STEP * 2);
      thumbTrack.style.transform = "translateX(-" + thumbOffset + "px)";
    });
  }

  /* ── Tab switching ── */
  var tabBar = document.getElementById("tab-bar");
  if (tabBar) {
    tabBar.addEventListener("click", function (e) {
      var btn = e.target.closest(".tab-btn");
      if (!btn) return;
      var tabId = btn.dataset.tab;

      // Update active tab
      tabBar.querySelectorAll(".tab-btn").forEach(function (b) {
        b.classList.remove("active");
      });
      btn.classList.add("active");

      // Update active panel
      document.querySelectorAll(".tab-panel").forEach(function (p) {
        p.classList.remove("active");
      });
      var panel = document.getElementById("tab-panel-" + tabId);
      if (panel) panel.classList.add("active");
    });
  }

  /* ── Sizing guide modal ── */
  var openSizingBtn = document.getElementById("open-sizing-guide");
  var sizingModal = document.getElementById("sizing-modal");
  var closeSizingBtn = document.getElementById("close-sizing-guide");

  if (openSizingBtn && sizingModal) {
    openSizingBtn.addEventListener("click", function () {
      sizingModal.showModal();
    });
    if (closeSizingBtn) {
      closeSizingBtn.addEventListener("click", function () {
        sizingModal.close();
      });
    }
    sizingModal.addEventListener("click", function (e) {
      if (e.target === sizingModal) sizingModal.close();
    });
  }

  /* ── Quantity selector ── */
  var qtyDisplay = document.getElementById("qty-display");
  var qtyMinus = document.getElementById("qty-minus");
  var qtyPlus = document.getElementById("qty-plus");
  var qty = 1;

  if (qtyMinus && qtyPlus && qtyDisplay) {
    qtyMinus.addEventListener("click", function () {
      if (qty > 1) { qty--; qtyDisplay.textContent = qty; }
    });
    qtyPlus.addEventListener("click", function () {
      qty++;
      qtyDisplay.textContent = qty;
    });
  }

  /* ── Variant selection ── */
  var selectEl = document.getElementById("variant-select");
  var addBtn = document.getElementById("add-to-cart");
  var priceEl = document.getElementById("variant-price");

  if (selectEl && addBtn) {
    selectEl.addEventListener("change", function () {
      var opt = selectEl.options[selectEl.selectedIndex];
      var avail = opt.dataset.available === "true";

      addBtn.dataset.variantId = selectEl.value;
      addBtn.disabled = !avail;
      addBtn.textContent = avail ? "Add to Cart" : "Sold Out";

      if (priceEl) {
        var newPrice = parseFloat(opt.dataset.price).toFixed(2);
        var curr = opt.dataset.currency;
        priceEl.textContent = curr + " " + newPrice;
      }
    });
  }

  /* ── Add to cart (with confirmation modal, per Remarks §16 / §17) ── */
  var confirmDlg = document.getElementById("add-confirm");
  var confirmContinue = document.getElementById("add-confirm-continue");

  if (addBtn) {
    addBtn.addEventListener("click", function () {
      if (addBtn.disabled || addBtn.classList.contains("loading")) return;
      var variantId = addBtn.dataset.variantId;
      if (!variantId) return;

      var currentQty = qty || 1;
      addBtn.classList.add("loading");
      var origText = addBtn.textContent;
      addBtn.textContent = "Adding\u2026";

      Cart.addToCart(variantId, currentQty)
        .then(function () {
          addBtn.textContent = origText;
          addBtn.classList.remove("loading");
          if (confirmDlg) {
            if (typeof confirmDlg.showModal === "function") confirmDlg.showModal();
            else confirmDlg.setAttribute("open", "");
          }
        })
        .catch(function (err) {
          console.error("Add to cart failed:", err);
          addBtn.textContent = "Error \u2013 try again";
          addBtn.classList.remove("loading");
          setTimeout(function () {
            addBtn.textContent = origText;
          }, 2000);
        });
    });
  }

  if (confirmContinue && confirmDlg) {
    confirmContinue.addEventListener("click", function () {
      if (typeof confirmDlg.close === "function") confirmDlg.close();
      else confirmDlg.removeAttribute("open");
    });
    confirmDlg.addEventListener("click", function (e) {
      if (e.target === confirmDlg) {
        if (typeof confirmDlg.close === "function") confirmDlg.close();
        else confirmDlg.removeAttribute("open");
      }
    });
  }

  /* ── Related products carousel ── */
  var relTrack = document.getElementById("related-track");
  var relPrev = document.getElementById("rel-prev");
  var relNext = document.getElementById("rel-next");
  if (relTrack && relPrev && relNext) {
    var CARD_W = 220 + 20;
    var relOffset = 0;
    var getRelMax = function () {
      return Math.max(0, relTrack.scrollWidth - relTrack.parentElement.clientWidth);
    };
    relPrev.addEventListener("click", function () {
      relOffset = Math.max(0, relOffset - CARD_W * 2);
      relTrack.style.transform = "translateX(-" + relOffset + "px)";
    });
    relNext.addEventListener("click", function () {
      relOffset = Math.min(getRelMax(), relOffset + CARD_W * 2);
      relTrack.style.transform = "translateX(-" + relOffset + "px)";
    });
  }

  /* ── Image lightbox (per Remarks §15) ── */
  (function initLightbox() {
    var trigger = document.getElementById("main-image-trigger");
    var lightbox = document.getElementById("image-lightbox");
    var lbImg = document.getElementById("lightbox-img");
    var lbClose = document.getElementById("lightbox-close");
    var lbPrev = document.getElementById("lightbox-prev");
    var lbNext = document.getElementById("lightbox-next");
    var mainImgEl = document.getElementById("main-image");
    if (!trigger || !lightbox || !lbImg || !mainImgEl) return;

    var thumbBtns = Array.prototype.slice.call(document.querySelectorAll(".thumb-btn"));
    var srcs = thumbBtns.length
      ? thumbBtns.map(function (b) { return b.dataset.src; })
      : [mainImgEl.src];

    var currentIdx = 0;

    function open(idx) {
      if (srcs.length === 0) return;
      currentIdx = ((idx % srcs.length) + srcs.length) % srcs.length;
      lbImg.src = srcs[currentIdx];
      lbImg.alt = mainImgEl.alt || "";
      if (typeof lightbox.showModal === "function") lightbox.showModal();
      else lightbox.setAttribute("open", "");
    }
    function close() {
      if (typeof lightbox.close === "function") lightbox.close();
      else lightbox.removeAttribute("open");
    }

    trigger.addEventListener("click", function () {
      var activeIdx = thumbBtns.findIndex(function (b) { return b.classList.contains("active"); });
      open(activeIdx >= 0 ? activeIdx : 0);
    });
    lbClose.addEventListener("click", close);
    lightbox.addEventListener("click", function (e) {
      if (e.target === lightbox || e.target === lbImg) close();
    });
    lbPrev && lbPrev.addEventListener("click", function (e) { e.stopPropagation(); open(currentIdx - 1); });
    lbNext && lbNext.addEventListener("click", function (e) { e.stopPropagation(); open(currentIdx + 1); });
    document.addEventListener("keydown", function (e) {
      if (!lightbox.open) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft" && lbPrev) lbPrev.click();
      else if (e.key === "ArrowRight" && lbNext) lbNext.click();
    });
  })();

  /* ── Record this product in Recently Viewed (per Remarks §11) ── */
  try {
    var rvMetaEl = document.getElementById("product-meta");
    if (rvMetaEl && rvMetaEl.dataset && rvMetaEl.dataset.handle) {
      var RV_KEY = "ohc:recently-viewed";
      var rvExisting = [];
      try { rvExisting = JSON.parse(localStorage.getItem(RV_KEY) || "[]"); } catch (e) {}
      var rvEntry = {
        handle: rvMetaEl.dataset.handle,
        title: rvMetaEl.dataset.title || "",
        image: rvMetaEl.dataset.image || "",
        price: parseFloat(rvMetaEl.dataset.price || "0"),
        currency: rvMetaEl.dataset.currency || "EUR",
        viewedAt: Date.now()
      };
      var rvDedup = rvExisting.filter(function (e) { return e && e.handle !== rvEntry.handle; });
      rvDedup.unshift(rvEntry);
      localStorage.setItem(RV_KEY, JSON.stringify(rvDedup.slice(0, 12)));
    }
  } catch (e) {}
})();
</script>
