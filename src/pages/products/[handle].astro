    position: absolute;
    top: 12px;
    right: 12px;
    background: #dc2626;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 20px;
    z-index: 1;
  }

  /* ── Horizontal Thumbnails ── */
  .thumb-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    min-width: 0;
  }
  .thumb-track-wrap {
    flex: 1;
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
  }
  .thumb-track {
    display: flex;
    gap: 0.5rem;
    transition: transform 0.3s ease;
  }
  .thumb-btn {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.15s;
  }
  .thumb-btn:hover { border-color: #93c5fd; }
  .thumb-btn.active { border-color: #1e3a5f; }
  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .thumb-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    background: #fff;
    color: #555;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s, border-color 0.15s;
  }
  .thumb-arrow:hover {
    background: #f0f4ff;
    border-color: #1e3a5f;
    color: #1e3a5f;
  }

  /* ── Details Column ── */
  .details {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }
  .product-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.3;
    margin: 0;
  }
  .product-sku {
    font-size: 0.8rem;
    color: #888;
    margin: 0;
  }
  .product-sku span { color: #555; }

  /* Availability */
  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    width: fit-content;
  }
  .availability-badge.in-stock { background: #dcfce7; color: #16a34a; }
  .availability-badge.out-of-stock { background: #fee2e2; color: #dc2626; }

  /* Price */
  .price-block {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .price-regular { font-size: 1.5rem; font-weight: 700; color: #1e3a5f; }
  .price-compare { font-size: 1.1rem; color: #9ca3af; text-decoration: line-through; }
  .price-sale { font-size: 1.5rem; font-weight: 700; color: #dc2626; }
  .price-quote {
    font-size: 1.02rem;
    font-weight: 600;
    color: #1e3a5f;
    background: #f1f5fb;
    border-left: 3px solid #2563eb;
