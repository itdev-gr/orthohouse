---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "./Breadcrumb.astro";
import { pickLang, useTranslations, localizeHref } from "../i18n/utils";

interface Props {
  /** Slug of the section currently shown — used to highlight sidebar item. */
  section: "dashboard" | "orders" | "addresses" | "profile";
  /** Page title (also added as the final breadcrumb crumb). */
  pageTitle: string;
  /** If true, the page is part of the public auth flow and skips the auth gate. */
  publicAuth?: boolean;
  /** Extra crumb between Account and the leaf (e.g. order number). */
  extraCrumb?: { label: string; href: string | null };
}

const { section, pageTitle, publicAuth = false, extraCrumb } = Astro.props as Props;
const lang = pickLang(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizeHref(p, lang);

const crumbs: { label: string; href: string | null }[] = [
  { label: t("nav.home"), href: lp("/") },
  { label: t("account.title"), href: lp("/account") },
];
if (extraCrumb) crumbs.push(extraCrumb);
crumbs.push({ label: pageTitle, href: null });
---

<Layout title={`${pageTitle} — ${t("account.title")}`}>
  <Breadcrumb crumbs={crumbs} />
  <div class="acc-shell">
    <aside class="acc-sidebar" aria-label={t("account.title")}>
      <a class={"acc-nav-item" + (section === "dashboard" ? " active" : "")} href={lp("/account")}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.5 1.5 0 0 1 2.121 0L22.5 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>
        {t("account.dashboard")}
      </a>
      <a class={"acc-nav-item" + (section === "orders" ? " active" : "")} href={lp("/account/orders")}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007Z"/></svg>
        {t("account.orders")}
      </a>
      <a class={"acc-nav-item" + (section === "addresses" ? " active" : "")} href={lp("/account/addresses")}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
        {t("account.addresses")}
      </a>
      <a class={"acc-nav-item" + (section === "profile" ? " active" : "")} href={lp("/account/profile")}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
        {t("account.profile")}
      </a>
      <a class="acc-nav-item acc-nav-logout" href={lp("/account/logout")}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75"/></svg>
        {t("account.logout")}
      </a>
    </aside>
    <main class="acc-main">
      <slot />
    </main>
  </div>
</Layout>

{!publicAuth && (
  <script is:inline data-login-href={lp("/account/login")}>
    (function () {
      // Auth gate — redirect to login if no token.
      var loginHref = document.currentScript.dataset.loginHref;
      function hasToken() {
        var t = localStorage.getItem("sf_customer_token");
        var exp = localStorage.getItem("sf_customer_token_expires");
        if (!t) return false;
        if (exp && new Date(exp).getTime() < Date.now()) return false;
        return true;
      }
      if (!hasToken()) {
        // Preserve the page we were trying to reach so login can bounce back.
        var dest = encodeURIComponent(window.location.pathname + window.location.search);
        window.location.replace(loginHref + "?next=" + dest);
      }
    })();
  </script>
)}

<style>
  .acc-shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto 3rem;
    padding: 0 1rem;
  }
  .acc-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-self: start;
    position: sticky;
    top: 1rem;
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    padding: 0.75rem;
  }
  .acc-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    color: #1e3a5f;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: background 0.12s, color 0.12s;
  }
  .acc-nav-item:hover { background: #f1f5fb; }
  .acc-nav-item.active {
    background: #1e3a5f;
    color: #fff;
  }
  .acc-nav-logout {
    margin-top: 0.5rem;
    border-top: 1px solid #f1f5fb;
    padding-top: 0.75rem;
    color: #b91c1c;
  }
  .acc-nav-logout:hover { background: #fef2f2; }

  .acc-main {
    min-width: 0;
    background: #fff;
    border: 1px solid #e8edf3;
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
  }

  :global(.acc-h1) {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1e3a5f;
    margin: 0 0 1rem;
  }
  :global(.acc-section) { margin-bottom: 1.75rem; }
  :global(.acc-section + .acc-section) { border-top: 1px solid #f1f5fb; padding-top: 1.5rem; }
  :global(.acc-section-title) {
    font-size: 1rem;
    font-weight: 600;
    color: #1e3a5f;
    margin: 0 0 0.5rem;
  }
  :global(.acc-muted) { color: #6b7280; font-size: 0.9rem; }

  :global(.acc-form) {
    display: grid;
    gap: 0.85rem;
    max-width: 480px;
  }
  :global(.acc-field) { display: grid; gap: 0.3rem; }
  :global(.acc-label) { font-size: 0.85rem; font-weight: 600; color: #374151; }
  :global(.acc-input) {
    appearance: none;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    font-size: 0.95rem;
    background: #fff;
    color: #111827;
  }
  :global(.acc-input:focus) {
    outline: 2px solid #2563eb;
    outline-offset: 1px;
    border-color: #2563eb;
  }
  :global(.acc-input[disabled]) { background: #f3f4f6; color: #9ca3af; }
  :global(.acc-checkbox-row) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: #374151;
  }
  :global(.acc-btn) {
    appearance: none;
    border: none;
    border-radius: 8px;
    padding: 0.7rem 1.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    background: #2563eb;
    color: #fff;
    text-align: center;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }
  :global(.acc-btn:hover) { background: #1d4ed8; }
  :global(.acc-btn[disabled]) { background: #9ca3af; cursor: not-allowed; }
  :global(.acc-btn-ghost) {
    background: #fff;
    color: #1e3a5f;
    border: 1px solid #d1d5db;
  }
  :global(.acc-btn-ghost:hover) { background: #f3f4f6; }
  :global(.acc-btn-danger) {
    background: transparent;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }
  :global(.acc-btn-danger:hover) { background: #fef2f2; }

  :global(.acc-alert) {
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    font-size: 0.9rem;
    margin: 0 0 1rem;
    display: none;
  }
  :global(.acc-alert.show) { display: block; }
  :global(.acc-alert-error) { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
  :global(.acc-alert-success) { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
  :global(.acc-alert-info) { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }

  :global(.acc-link) {
    color: #2563eb;
    text-decoration: none;
    font-size: 0.9rem;
  }
  :global(.acc-link:hover) { text-decoration: underline; }

  @media (max-width: 760px) {
    .acc-shell { grid-template-columns: 1fr; }
    .acc-sidebar {
      flex-direction: row;
      overflow-x: auto;
      position: relative;
      padding: 0.5rem;
    }
    .acc-nav-item { flex-shrink: 0; }
    .acc-nav-logout { border-top: none; margin-top: 0; padding-top: 0.65rem; }
  }
</style>
