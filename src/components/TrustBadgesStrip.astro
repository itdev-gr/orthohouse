---
import { pickLang, useTranslations } from "../i18n/utils";

const lang = pickLang(Astro.currentLocale, Astro.url);
const t = useTranslations(lang);

const badges = [
  {
    key: "wolt",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.5h16.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H3.75a.75.75 0 0 1-.75-.75V5.25a.75.75 0 0 1 .75-.75Zm3 5.25 2 2 4-4 4 4 2-2"/>',
  },
  {
    key: "authorised",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M12 2.714A11.96 11.96 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.75c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.572-.598-3.751h-.152a11.96 11.96 0 0 1-8.25-3.285Z"/>',
  },
  {
    key: "euCertified",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M16.712 4.33a9.027 9.027 0 0 1 1.652 1.306c.51.51.944 1.064 1.306 1.652M16.712 4.33l-3.448 4.138m3.448-4.138a9.014 9.014 0 0 0-9.424 0M19.67 7.288l-4.138 3.448m4.138-3.448a9.014 9.014 0 0 1 0 9.424m-4.138-5.976a3.736 3.736 0 0 0-.88-1.388 3.737 3.737 0 0 0-1.388-.88m2.268 2.268a3.765 3.765 0 0 1 0 2.528m-2.268-4.796L11 7.5m4.532 4.236A3.736 3.736 0 0 1 14.65 13.5a3.74 3.74 0 0 1-1.388.88m2.268-2.268L19.67 16.712m-4.138-4.976L11 16.5m-4.138 0 4.138-4.138"/>',
  },
  {
    key: "customFitting",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487 18.549 2.8a2.121 2.121 0 1 1 3 3L5.12 22.226 1.5 22.5l.274-3.62L16.862 4.487Zm0 0L19.5 7.125"/>',
  },
  {
    key: "freeDelivery",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>',
  },
  {
    key: "satisfaction",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>',
  },
] as const;
---

<section class="badges-strip" aria-label={lang === "el" ? "Λόγοι εμπιστοσύνης" : "Why shop with us"}>
  <ul class="badges-grid">
    {badges.map((b) => (
      <li class="badge-item">
        <span class="badge-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.6" set:html={b.icon}></svg>
        </span>
        <span class="badge-title">{t(`trustbar.${b.key}.title` as any)}</span>
        <span class="badge-sub">{t(`trustbar.${b.key}.sub` as any)}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .badges-strip {
    background: #f8fafc;
    padding: 2.5rem 1.5rem;
    margin-bottom: 3rem;
    border-top: 1px solid #e8edf3;
    border-bottom: 1px solid #e8edf3;
  }
  .badges-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1200px;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.45rem;
    color: #1e3a5f;
  }
  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #fff;
    color: #2563eb;
    box-shadow: 0 3px 10px rgba(15, 23, 42, 0.06);
  }
  .badge-title {
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.25;
  }
  .badge-sub {
    font-size: 0.78rem;
    color: #555;
    max-width: 22ch;
    line-height: 1.35;
  }

  @media (max-width: 960px) {
    .badges-grid { grid-template-columns: repeat(3, 1fr); row-gap: 2rem; }
  }
  @media (max-width: 520px) {
    .badges-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
